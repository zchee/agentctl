# A namespaced forward swap parks the displaced pair beside its own store.
swapfixture namespace
exec agentctl claude use $INCOMING --live --yes --json
stdout '"outcome": "applied"'
stdout '"config": null'
stdout '"budget_ms": 3000'
! stdout SENTINEL
! stderr SENTINEL
swap-check 1 0 0

# A first item write records no keychain baseline and removes only the shadow.
swapfixture first-write
exec agentctl claude use $INCOMING --live --yes --json
stdout '"outcome": "applied"'
stdout '"digest8": null'
! exists $SWAP_STORE/.credentials.json
exists $SWAP_STORE/.credentials.adopted.json
! stdout SENTINEL
! stderr SENTINEL
swap-check 1 0 0

# A duplicate in unmigrated plaintext does not implicitly migrate the store.
swapfixture unmigrated-duplicate
exec agentctl claude use $INCOMING --live --yes --json
stdout '"outcome": "already_active"'
exists $SWAP_STORE/.credentials.json
! exists $SWAP_STORE/.credentials.adopted.json
! stdout SENTINEL
! stderr SENTINEL
swap-check 0 0 0

# JSON is a plan, never consent; declining never rotates or adopts a pair.
