# Read-only session labels stay on stderr; JSON carries counts only.
swapfixture live-session-hints
exec agentctl claude use $INCOMING --live --yes --json
stdout '1 Claude Code session'
! stdout 'private-session-name'
stderr 'private-session-name'
! stdout SENTINEL
! stderr SENTINEL
swap-check 1 0 2

swapfixture live-catch-up-hints
exec agentctl claude use $INCOMING --live --yes --json
stdout '"outcome": "already_active"'
stdout '1 Claude Code session'
! stdout 'private-session-name'
stderr 'private-session-name'
! stdout SENTINEL
! stderr SENTINEL
swap-check 0 0 1
exec agentctl claude use $INCOMING --live --yes --json
stdout '"reason": "already_current"'
! stdout 'Remote Control'
! stderr 'had Remote Control'
! stdout SENTINEL
! stderr SENTINEL
swap-check 0 0 2

