# a_live_undo_rewrites_oauth_account_with_the_restored_accounts_profile
swapfixture live undo-config-profile
undo-setup
undo-config $OWNER link
cp $UNDO_CONFIG initial-config
exec agentctl claude use $INCOMING --live --yes --json
cp $UNDO_CONFIG forward-config
exec agentctl claude use --undo --yes --json
stdout '"outcome": "applied"'
undo-config-check $OWNER initial-config forward-config
undo-check 2 0 4

# an_undo_whose_config_write_was_skipped_is_caught_up_by_use_live_of_the_restored_account
swapfixture live undo-config-catch-up
undo-setup own
undo-config $OWNER link
exec agentctl claude use $INCOMING --live --yes --json
mkdir $UNDO_CONFIG.lock
exec agentctl claude use --undo --yes --json
stdout '"outcome": "applied"'
stdout '"reason": "lock_busy"'
stderr 'run .*claude use --live'
! stderr 'run .*use --undo'
rm $UNDO_CONFIG.lock
exec agentctl claude use $OWNER --live --yes --json
stdout '"outcome": "already_active"'
undo-config-check $OWNER
undo-check 2 0 5

