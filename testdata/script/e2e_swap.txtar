# Undo and forget.
# Provenance: tests/e2e_swap.rs.

# Namespace reversal restores the displaced pair and parks the incoming pair.
swapfixture namespace undo-namespace
undo-setup
exec agentctl claude use $INCOMING --live --yes --json
exec agentctl claude use --undo --yes --json
stdout '"outcome": "applied"'
undo-credential $UNDO_ITEM outgoing
undo-credential $UNDO_OWNER_DIR/.credentials.adopted.json incoming
! exists $UNDO_OWNER_DIR/.credentials.json
undo-audit-check forward:- undo:-
undo-check 2 0 0

# A failed forward write leaves recovery intact and is not selectable.
swapfixture namespace undo-failed-forward
undo-setup
env AGENTCTL_FAULT=swap_write_fail
exec expectexit 19 agentctl claude use $INCOMING --live --yes --json
env AGENTCTL_FAULT=
exec agentctl claude use --undo --yes
stdout 'no swap to undo'
undo-credential $UNDO_ITEM outgoing
undo-credential $UNDO_OWNER_DIR/.credentials.adopted.json outgoing
undo-check 0 0 0

# An empty log is a successful no-op with no child, write, or profile request.
swapfixture namespace undo-empty
undo-setup
exec agentctl claude use --undo --yes
stdout 'no swap to undo'
undo-check 0 0 0

# A live entry naming no retained credential refuses without a keychain read.
swapfixture live undo-missing-copy
undo-setup
exec agentctl claude use $INCOMING --live --yes --json
undo-audit missing-copy
cp $SWAP_AUDIT before-audit
exec expectexit 1 agentctl claude use --undo --yes
stderr 'deadbeef'
stderr 'nothing to put back'
cmp $SWAP_AUDIT before-audit
undo-check 1 0 2

# A namespaced recovery copy must match the displaced audit digest.
swapfixture namespace undo-wrong-copy
undo-setup
exec agentctl claude use $INCOMING --live --yes --json
undo-blob $UNDO_OWNER_DIR/.credentials.adopted.json stranger $OWNER
cp $SWAP_AUDIT before-audit
exec expectexit 1 agentctl claude use --undo --yes
stderr 'will not put back'
cmp $SWAP_AUDIT before-audit
undo-credential $UNDO_ITEM incoming
undo-check 1 0 0

# Reversing a first keychain write does not resurrect a plaintext store.
swapfixture first-write undo-first-write
undo-setup
exec agentctl claude use $INCOMING --live --yes --json
! exists $UNDO_OWNER_DIR/.credentials.json
exec agentctl claude use --undo --yes --json
stdout '"outcome": "applied"'
undo-credential $UNDO_ITEM outgoing
undo-credential $UNDO_OWNER_DIR/.credentials.adopted.json incoming
! exists $UNDO_OWNER_DIR/.credentials.json
undo-check 2 0 0

# A moved export spelling refuses before any additional keychain operation.
swapfixture namespace undo-moved-store
undo-setup
exec agentctl claude use $INCOMING --live --yes --json
undo-move-record
exec expectexit 15 agentctl claude use --undo --yes
stdout 'the store moved'
undo-credential $UNDO_OWNER_DIR/.credentials.adopted.json outgoing
undo-check 1 0 0

# A peer change after the initial read discards the reversal and keeps its source.
swapfixture namespace undo-peer-write
undo-setup
exec agentctl claude use $INCOMING --live --yes --json
undo-security peer
exec expectexit 17 agentctl claude use --undo --yes --json &
exec waitfor $UNDO_RESUME.reached
undo-blob $UNDO_ITEM incoming-peer $INCOMING
exec /usr/bin/touch $UNDO_RESUME
wait
stdout '"outcome": "discarded"'
undo-credential $UNDO_ITEM incoming-peer
undo-credential $UNDO_OWNER_DIR/.credentials.adopted.json outgoing
undo-check 1 0 0

# A changed lock inside the hold refuses without replacing the retained source.
swapfixture namespace undo-compromised-hold
undo-setup
exec agentctl claude use $INCOMING --live --yes --json
env AGENTCTL_FAULT=swap_pause_in_locks
env AGENTCTL_FAULT_RESUME=$UNDO_RESUME
exec expectexit 10 agentctl claude use --undo --yes --json &
exec waitfor $UNDO_OWNER_DIR/.oauth_refresh.lock
undo-age $UNDO_OWNER_DIR/.oauth_refresh.lock
exec /usr/bin/touch $UNDO_RESUME
wait
env AGENTCTL_FAULT=
env AGENTCTL_FAULT_RESUME=
stdout '"refusal": "A"'
undo-credential $UNDO_OWNER_DIR/.credentials.adopted.json outgoing
undo-check 1 0 0

# A busy store leaves the rollback source intact.
swapfixture namespace undo-busy
undo-setup
exec agentctl claude use $INCOMING --live --yes --json
mkdir $UNDO_OWNER_DIR/.oauth_refresh.lock
exec expectexit 16 agentctl claude use --undo --yes --json
stdout '"outcome": "busy"'
rm $UNDO_OWNER_DIR/.oauth_refresh.lock
undo-credential $UNDO_OWNER_DIR/.credentials.adopted.json outgoing
undo-check 1 0 0

# A failed reverse write retains the restoring pair and gives reverse-specific recovery.
swapfixture namespace undo-write-failed
undo-setup
exec agentctl claude use $INCOMING --live --yes --json
env AGENTCTL_FAULT=swap_write_fail
exec expectexit 19 agentctl claude use --undo --yes --json
stdout 'untouched in the adopted copy'
! stdout 'recoverable with.*use --undo'
env AGENTCTL_FAULT=
undo-credential $UNDO_ITEM incoming
undo-credential $UNDO_OWNER_DIR/.credentials.adopted.json outgoing
undo-check 1 0 0

# An unknown reverse write does not commit the staged occupant over its source.
swapfixture namespace undo-write-unknown
undo-setup
exec agentctl claude use $INCOMING --live --yes --json
undo-security hang
exec expectexit 18 agentctl claude use --undo --yes --json
stdout '"outcome": "unknown"'
stdout 'cannot itself be undone'
undo-credential $UNDO_ITEM incoming
undo-credential $UNDO_OWNER_DIR/.credentials.adopted.json outgoing
exec expectexit 1 agentctl claude use --undo --yes
stderr 'will not put back'
undo-check 2 0 0

# A newer displaced grant survives and can be restored without a refresh POST.
swapfixture namespace undo-newer-copy
undo-setup
undo-blob $UNDO_ITEM incoming-session $INCOMING newer
exec agentctl claude use $INCOMING --live --yes --json
exec agentctl claude use --undo --yes --json
stdout '"outcome": "applied"'
undo-credential $UNDO_ITEM incoming-session
undo-credential $UNDO_OWNER_DIR/.credentials.adopted.json incoming
undo-check 2 0 0

# Live identity comes from the profile again after the installed grant is refreshed.
swapfixture live-compact-config undo-profile-identity
undo-setup
undo-blob $UNDO_ITEM outgoing -
cp $UNDO_CONFIG before-config
exec agentctl claude use $INCOMING --live --yes --json
cp $UNDO_OWNER_DIR/.credentials.adopted.json parked-owner
undo-blob $UNDO_ITEM incoming-refreshed - newer
exec agentctl claude use --undo --yes --json
stdout '"outcome": "applied"'
cmp $UNDO_ITEM parked-owner
cmp $UNDO_CONFIG before-config
undo-credential $UNDO_INCOMING_DIR/.credentials.json incoming-refreshed
! exists $UNDO_OWNER_DIR/.credentials.json
! exists $UNDO_INCOMING_DIR/.credentials.adopted.json
undo-check 2 0 4

# Every live write records the account it installed, in both directions.
swapfixture live undo-installed-identity
undo-setup
exec agentctl claude use $INCOMING --live --yes --json
exec agentctl claude use --undo --yes --json
undo-audit-check forward:$INCOMING undo:$OWNER
undo-check 2 0 4

# Two successive live swaps and two reversals install the matching account each time.
swapfixture live-compact-config undo-two-live-swaps
undo-setup
cp $UNDO_CONFIG before-config
exec agentctl claude use $INCOMING --live --yes --json
undo-blob $UNDO_ITEM incoming-refreshed - newer
cp $UNDO_ITEM first-incoming
exec agentctl claude use $THIRD --live --yes --json
undo-credential $UNDO_ITEM third
cp $UNDO_ITEM second-incoming
exec agentctl claude use --undo --yes --json
cmp $UNDO_ITEM first-incoming
exec agentctl claude use --undo --yes --json
cmp $UNDO_ITEM second-incoming
cmp $UNDO_INCOMING_DIR/.credentials.json first-incoming
cmp $UNDO_CONFIG before-config
undo-audit-check forward:$INCOMING forward:$THIRD undo:$INCOMING undo:$THIRD
undo-check 4 0 8

# Undo-of-undo puts back the original incoming grant and resolves later equal copies.
swapfixture live undo-of-undo
undo-setup
exec agentctl claude use $INCOMING --live --yes --json
cp $UNDO_ITEM incoming-in-item
exec agentctl claude use --undo --yes --json
cp $UNDO_ITEM owner-in-item
exec agentctl claude use --undo --yes --json
cmp $UNDO_ITEM incoming-in-item
undo-audit-check forward:$INCOMING undo:$OWNER undo:$INCOMING
exec agentctl claude use --undo --yes --json
cmp $UNDO_ITEM owner-in-item
! exists $UNDO_OWNER_DIR/.credentials.adopted.json
undo-check 4 0 8

# Namespace refreshes beyond a 256-line window do not hide a reversible live swap.
swapfixture live undo-whole-log
undo-setup
exec agentctl claude use $INCOMING --live --yes --json
cp $UNDO_OWNER_DIR/.credentials.adopted.json parked-owner
undo-audit tail
exec agentctl claude use --undo --yes --json
stdout '"target": "live"'
cmp $UNDO_ITEM parked-owner
undo-check 2 0 4

# An unknown undo that did not land retries the outstanding forward swap.
