undo-blob $UNDO_ITEM incoming-refreshed - newer
exec agentctl claude use --undo --yes --json
undo-credential $UNDO_INCOMING_DIR/.credentials.json incoming-refreshed
exec agentctl claude use $INCOMING --live --yes --json
stdout '"outcome": "applied"'
undo-credential $UNDO_ITEM incoming-refreshed
undo-check 3 0 6

# A newer owner grant after undo supersedes the recorded adopted copy without creating plaintext.
swapfixture live undo-forward-owner-refreshed
undo-setup
exec agentctl claude use $INCOMING --live --yes --json
exec agentctl claude use --undo --yes --json
undo-blob $UNDO_ITEM outgoing-refreshed - newer
cp $UNDO_ITEM before-item
exec agentctl claude use $INCOMING --live --yes --json
stdout '"outcome": "applied"'
cmp $UNDO_OWNER_DIR/.credentials.adopted.json before-item
! exists $UNDO_OWNER_DIR/.credentials.json
undo-check 3 0 6

# An unrecorded duplicate may not be replaced merely because the live owner grant is newer.
swapfixture live undo-unrecorded-duplicate
undo-setup own
cp $UNDO_ITEM $UNDO_OWNER_DIR/.credentials.adopted.json
cp $UNDO_OWNER_DIR/.credentials.json before-owner
undo-blob $UNDO_ITEM outgoing-refreshed - newer
cp $UNDO_ITEM before-item
exec expectexit 14 agentctl claude use $INCOMING --live --yes --json
stdout '"refusal": "F"'
stdout 'was not parked by a live swap'
cmp $UNDO_ITEM before-item
cmp $UNDO_OWNER_DIR/.credentials.json before-owner
