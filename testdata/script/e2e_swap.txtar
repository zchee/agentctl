# A concurrent incoming-store writer survives guarded refreshed persistence.
swapfixture refresh-save-race
exec agentctl claude use $INCOMING --live --yes --json
stdout '"outcome": "applied"'
stdout 'refreshed credential was not saved back'
stderr 'refreshed credential was not saved back'
! stdout SENTINEL
! stderr SENTINEL
swap-check 1 1 0

