swap-status-blob $REFRESH_NS/.credentials.adopted.json parked $OWNER owner@example.com fresh
cp $REFRESH_NS/.credentials.adopted.json status-invalid-grant-parked
env AGENTCTL_FAULT=pause_before_invalid_grant_reread
exec agentctl claude status --json --refresh --timeout 30s --account owner@example.com &statusinvalid&
refresh-action wait-pause
swap-status-posts 1
swap-status-blob $REFRESH_ITEM occupant $THIRD third@example.com fresh
cp $REFRESH_ITEM status-invalid-grant-item
refresh-action resume
wait statusinvalid
cp stdout status-invalid-grant-report
swap-status-row status-invalid-grant-report $OWNER third@example.com
! stdout SENTINEL
! stderr SENTINEL
cmp $REFRESH_ITEM status-invalid-grant-item
cmp $REFRESH_NS/.credentials.adopted.json status-invalid-grant-parked
refresh-calls 0 0 0
swap-status-posts 1
refresh-check read-only
refresh-check keychain-calls 5 8
refresh-check peers-absent
! exists $REFRESH_NS/.credentials.json

# a_live_swap_writes_the_unsuffixed_item_and_locks_the_resolved_store
# a_live_swap_touches_nothing_outside_the_namespace_root_but_the_three_artefacts
swapfixture live live-containment
undo-setup
rm $HOME/.claude/.credentials.json
rm $UNDO_CONFIG
mv $HOME/.claude $HOME/.claude-real
symlink $HOME/.claude -> $HOME/.claude-real
env SWAP_STORE=$HOME/.claude
mkdir $SWAP_STORE/.oauth_refresh.lock
undo-age $SWAP_STORE/.oauth_refresh.lock
env AGENTCTL_FAULT=lock_stale
cp $UNDO_ITEM containment-before-item
swap-live-watch
exec agentctl claude use $INCOMING --live --yes --json
stdout '"outcome": "applied"'
stdout '"outcome": "skipped"'
stdout '"reason": "absent"'
stderr 'no `~/.claude.json` to update'
! stdout SENTINEL
! stderr SENTINEL
cp stdout containment-report
swap-hold-json containment-report 3000
swap-live-watch-check
swap-live-equal $UNDO_OWNER_DIR/.credentials.adopted.json containment-before-item
swap-live-equal $UNDO_ITEM $UNDO_INCOMING_DIR/.credentials.json
! exists $UNDO_OWNER_DIR/.credentials.json
! exists $UNDO_CONFIG
swap-io 3 0 0
undo-check 1 0 2
swap-audit applied 1

# a_write_back_into_a_namespace_a_claude_session_holds_is_refused
swapfixture namespace vendor-held-writeback
undo-setup
undo-blob $UNDO_INCOMING_DIR/.credentials.json incoming $INCOMING expired
cp $UNDO_INCOMING_DIR/.credentials.json vendor-before-source
cp $HOME/.claude/.credentials.json vendor-before-live
mkdir $UNDO_INCOMING_DIR/.oauth_refresh.lock
exec agentctl claude use $INCOMING --live --yes
stdout 'swapped:'
stderr 'a Claude Code session holds `.oauth_refresh.lock` there'
! stdout SENTINEL
! stderr SENTINEL
cmp $UNDO_INCOMING_DIR/.credentials.json vendor-before-source
cmp $HOME/.claude/.credentials.json vendor-before-live
exists $UNDO_INCOMING_DIR/.oauth_refresh.lock
undo-credential $UNDO_ITEM outgoing-rotated
undo-credential $UNDO_OWNER_DIR/.credentials.adopted.json outgoing
! exists $UNDO_OWNER_DIR/.credentials.json
! exists $UNDO_INCOMING_DIR/.credentials.adopted.json
swap-io 4 0 0
swap-audit applied 0
# Release only the planted vendor artifact after proving it survived, then check our cleanup.
rm $UNDO_INCOMING_DIR/.oauth_refresh.lock
undo-check 1 1 0

