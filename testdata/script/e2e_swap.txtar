# the_adopted_copy_is_removed_when_the_account_is_removed
swapfixture namespace remove-adopted
undo-setup
exec agentctl claude use $INCOMING --live --yes --json
stdout '"outcome": "applied"'
exists $UNDO_OWNER_DIR/.credentials.adopted.json
! exists $UNDO_OWNER_DIR/.credentials.json
swap-check 1 0 0
swap-io 3 0 0
swap-audit applied 0
cp $SWAP_ROOT/security.log removal-before-security
cp $UNDO_ITEM removal-before-item
exec agentctl claude accounts remove $OWNER --yes --delete-secret
! exists $UNDO_OWNER_DIR/.credentials.adopted.json
! exists $UNDO_OWNER_DIR
cmp $SWAP_ROOT/security.log removal-before-security
cmp $UNDO_ITEM removal-before-item
! stdout SENTINEL
! stderr SENTINEL

# an_item_holding_another_copy_of_the_incoming_account_applies_and_then_says_already_active
swapfixture refresh incoming-copy-repeat
undo-setup own-alias
rm $UNDO_OWNER_DIR/.credentials.json
undo-blob $UNDO_ITEM incoming-earlier $INCOMING
cp $UNDO_ITEM earlier-incoming
exec agentctl claude use $INCOMING --live --yes --json
stdout '"outcome": "applied"'
stdout '"refusal": null'
stdout '"adopted_to": ".credentials.adopted.json"'
! stdout SENTINEL
! stderr SENTINEL
undo-credential $UNDO_INCOMING_DIR/.credentials.json outgoing-rotated
cmp $UNDO_ITEM $UNDO_INCOMING_DIR/.credentials.json
