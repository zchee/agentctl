exec agentctl claude use $INCOMING --live --yes --json
undo-blob $UNDO_OWNER_DIR/.credentials.adopted.json outgoing $OWNER expired
undo-blob $UNDO_OWNER_DIR/.credentials.json outgoing-independent $OWNER newer
cp $UNDO_OWNER_DIR/.credentials.json independent-owner
exec agentctl claude use --undo --yes --json
undo-credential $UNDO_OWNER_DIR/.credentials.adopted.json outgoing-rotated
undo-blob $UNDO_ITEM outgoing-descendant - newer
cp $UNDO_ITEM descendant
exec agentctl claude use $INCOMING --live --yes --json
stdout '"outcome": "applied"'
cmp $UNDO_OWNER_DIR/.credentials.adopted.json descendant
cmp $UNDO_OWNER_DIR/.credentials.json independent-owner
undo-check 3 1 6

