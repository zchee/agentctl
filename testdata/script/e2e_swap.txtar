# Provenance: tests/e2e_swap.rs (forward, undo, forget and read-only remote-control cases); tests/e2e_isolate.rs is covered by e2e_isolate.txtar.
# a_swap_adopts_the_displaced_credential_into_the_adopted_copy_never_the_store
# a_swap_touches_nothing_outside_the_namespace_root
# use_live_json_carries_the_lock_timings_and_never_a_token
# a_namespace_swap_is_unchanged_by_the_profile
# a_namespace_swap_never_touches_claude_json
swapfixture namespace
exec agentctl claude use $INCOMING --live --yes --json
stdout '"outcome": "applied"'
stdout '"config": null'
stdout '"budget_ms": 3000'
! stdout SENTINEL
! stderr SENTINEL
swap-check 1 0 0
swap-io 3 0 0
swap-tree

# a_first_write_records_a_null_from_digest8_and_removes_the_shadowing_store
swapfixture first-write
exec agentctl claude use $INCOMING --live --yes --json
stdout '"outcome": "applied"'
stdout '"digest8": null'
! exists $SWAP_STORE/.credentials.json
exists $SWAP_STORE/.credentials.adopted.json
! stdout SENTINEL
! stderr SENTINEL
swap-check 1 0 0

