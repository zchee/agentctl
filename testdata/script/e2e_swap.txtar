undo-audit unknown-undo
cp $UNDO_OWNER_DIR/.credentials.adopted.json $UNDO_ITEM
cp $UNDO_ITEM before-item
exec agentctl claude use --undo --yes --json
stdout '"outcome": "already_active"'
