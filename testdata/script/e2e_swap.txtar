exec agentctl claude use --undo --yes --json
cp $UNDO_ITEM before-item
exec agentctl claude use $INCOMING --live --yes --json
stdout '"outcome": "applied"'
cmp $UNDO_OWNER_DIR/.credentials.adopted.json before-item
! exists $UNDO_OWNER_DIR/.credentials.json
undo-check 3 0 6

# A refreshed incoming grant is filed by undo and reused by a subsequent live swap.
