undo-check 2 0 4

# A new login as the displaced account is already active and is never misfiled as incoming.
swapfixture live undo-owner-relogin
undo-setup
exec agentctl claude use $INCOMING --live --yes --json
undo-blob $UNDO_ITEM outgoing-relogin -
cp $UNDO_ITEM before-item
cp $UNDO_OWNER_DIR/.credentials.adopted.json before-adopted
cp $UNDO_INCOMING_DIR/.credentials.json before-incoming
exec agentctl claude use --undo --yes --json
stdout '"outcome": "already_active"'
stdout 'nothing to put back'
cmp $UNDO_ITEM before-item
cmp $UNDO_OWNER_DIR/.credentials.adopted.json before-adopted
cmp $UNDO_INCOMING_DIR/.credentials.json before-incoming
undo-check 1 0 3

# A status refresh of the owner's own store leaves the independently parked undo source usable.
swapfixture live undo-status-refreshed-owner
undo-setup
exec agentctl claude use $INCOMING --live --yes --json
cp $UNDO_OWNER_DIR/.credentials.adopted.json parked-owner
undo-blob $UNDO_OWNER_DIR/.credentials.json outgoing-status-refreshed $OWNER newer
exec agentctl claude use --undo --yes --json
stdout '"outcome": "applied"'
cmp $UNDO_ITEM parked-owner
undo-credential $UNDO_OWNER_DIR/.credentials.json outgoing-status-refreshed
undo-check 2 0 4

# Equal copies retained by an undo permit a subsequent live swap.
