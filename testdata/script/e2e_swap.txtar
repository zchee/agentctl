# supplemental: store movement between item naming and namespace acquisition
swapfixture namespace store-move-interleaving
undo-setup
env ORG=66666666-7777-8888-9999-000000000000
env LOCKS=$AGENTCTL_CONFIG_DIR/claude/.locks
cp moved-store-marker $UNDO_OWNER_DIR/marker
cp $UNDO_ITEM moved-before-item
cp $UNDO_INCOMING_DIR/.credentials.json moved-before-incoming
cp $UNDO_REGISTRY moved-before-registry
env AGENTCTL_FAULT=pause_swap_namespace_acquired
exec expectexit 14 agentctl claude use $INCOMING --live --yes --json &storemove&
exec waitfor $AGENTCTL_FAULT_RESUME.reached
exists $LOCKS/$OWNER.$ORG.lock
! exists $LOCKS/$INCOMING.$ORG.lock
! exec flockhold $LOCKS/$OWNER.$ORG.lock 1ms
stderr 'already held'
swap-io 1 0 0
mv $UNDO_OWNER_DIR $SWAP_ROOT/moved-owner
symlink $UNDO_OWNER_DIR -> $SWAP_ROOT/moved-owner
swap-action resume
wait storemove
stdout '"refusal": "F"'
stdout '"config": null'
! stdout SENTINEL
! stderr SENTINEL
cmp $UNDO_ITEM moved-before-item
cmp $UNDO_INCOMING_DIR/.credentials.json moved-before-incoming
cmp $UNDO_REGISTRY moved-before-registry
cmp $SWAP_ROOT/moved-owner/marker moved-store-marker
! exists $SWAP_ROOT/moved-owner/.credentials.adopted.json
! exists $SWAP_ROOT/moved-owner/.credentials.json
! exists $SWAP_AUDIT
exec flockhold $LOCKS/$OWNER.$ORG.lock 1ms
exec flockhold $LOCKS/$INCOMING.$ORG.lock 1ms
undo-check 0 0 0
swap-check 0 0 0
swap-io 1 0 0

