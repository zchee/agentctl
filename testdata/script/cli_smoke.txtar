# The thin surface check over the built binary: argument parsing, help,
# version, the completion scripts and the usage-error contract, exactly
# as a user meets them. The wider suites get one script per behaviour
# area; this one stays the smoke test.

# Help and version succeed and name the command surface.
exec agentctl --help
stdout 'Available Commands:'
stdout 'claude'
stdout 'codex'
stdout 'completions'

exec agentctl --version
stdout 'agentctl version'

# The provider group lists every subcommand.
exec agentctl claude --help
stdout 'status'
stdout 'watch'
stdout 'login'
stdout 'accounts'
stdout 'import'
stdout 'doctor'

# Each supported shell gets its script on stdout.
exec agentctl completions zsh
stdout '^#compdef agentctl'

exec agentctl completions bash
stdout '_agentctl'

exec agentctl completions fish
stdout 'complete -c agentctl'

exec agentctl completions powershell
stdout 'agentctl'

# An unsupported shell is a usage error that names the supported set.
! exec agentctl completions tcsh
stderr 'supported shells are bash, zsh, fish, and powershell'

! exec agentctl completions elvish
stderr 'supported shells are bash, zsh, fish, and powershell'

# Unknown commands are refused before anything runs.
! exec agentctl bogus
stderr 'unknown command'

! exec agentctl claude bogus
stderr 'unknown command "bogus" for "agentctl claude"'

! exec agentctl claude
stderr 'agentctl claude --help'

# The exit contract, by number rather than by zero/non-zero: usage errors
# and Claude status on an empty store exit 2; Codex status with no home
# and no recorded accounts succeeds without inventing a live row.
exec expectexit 2 agentctl completions tcsh
exec expectexit 2 agentctl bogus
exec expectexit 2 agentctl claude bogus
exec expectexit 2 agentctl claude status --timeout nonsense
exec expectexit 2 agentctl claude status
stderr 'agentctl: 1 shown account\(s\) could not be read'
! stderr '(panic:|sk-ant)'
exec expectexit 0 agentctl --version

# The startup locked-memory check and the exit-path purge leave the
# ordinary statuses untouched: a clean run still exits 0 and a fatal
# one still exits 1.
exec expectexit 0 agentctl completions zsh
exec expectexit 0 agentctl codex status
