# a_symlinked_pending_is_invalid
refreshfixture pending-symlink
env AGENTCTL_FAULT=rename_fail
exec expectexit 2 agentctl claude status --refresh --account owner@example.com
! stderr 'sk-ant|SENTINEL'
stdout 'refresh saved to pending'
refresh-calls 1 1 0
env AGENTCTL_FAULT=
refresh-action pending
exec expectexit 2 agentctl claude status --refresh --account owner@example.com
! stderr 'sk-ant|SENTINEL'
stdout 'pending discarded: invalid'
refresh-calls 2 2 0
refresh-check namespace .credentials.json
cmp $REFRESH_ROOT/untouched untouched

# a_first_write_pending_replays_onto_an_empty_namespace
refreshfixture pending-first
exec agentctl claude status --refresh --account owner@example.com
! stderr 'sk-ant|SENTINEL'
stdout 'pending replayed'
refresh-calls 1 0 0
refresh-check stored pending
refresh-check namespace .credentials.json

# a_pending_whose_file_was_removed_is_discarded
refreshfixture pending-removed
exec expectexit 2 agentctl claude status --refresh --account owner@example.com
! stderr 'sk-ant|SENTINEL'
stdout 'needs login'
refresh-calls 0 0 0
refresh-check namespace

# a_migrated_namespace_discards_its_pending
refreshfixture pending-migrated
env AGENTCTL_FAULT=rename_fail
exec expectexit 2 agentctl claude status --refresh --account owner@example.com
! stderr 'sk-ant|SENTINEL'
stdout 'refresh saved to pending'
refresh-calls 1 1 0
env AGENTCTL_FAULT=
refresh-action pending
exec expectexit 2 agentctl claude status --refresh --account owner@example.com
! stderr 'sk-ant|SENTINEL'
stdout 'pending discarded: namespace taken over'
refresh-calls 1 1 0
refresh-check namespace .credentials.json
refresh-check file-unchanged
refresh-check read-only

# a_migrated_namespace_refreshes_its_own_keychain_item_in_place
refreshfixture migrated
exec agentctl claude status --json --refresh --account owner@example.com
! stderr 'sk-ant|SENTINEL'
refresh-check row stdout state ok
refresh-check row stdout source keychain
refresh-check row stdout lock_state migrated_refreshed
refresh-calls 1 1 0
refresh-check stored rotated
refresh-check write
refresh-check audit applied
refresh-check keychain-calls 6 11
refresh-check namespace
refresh-check peers-absent

# a_peer_refresh_before_the_post_is_adopted_and_costs_no_grant
refreshfixture peer-before-post
exec agentctl claude status --json --refresh --account owner@example.com &peer&
refresh-action wait-pause
refresh-action peer
refresh-action resume
wait peer
! stderr 'sk-ant|SENTINEL'
refresh-check row stdout state ok
refresh-check row stdout lock_state adopted
refresh-check row stdout note 'a Claude Code session refreshed this item'
refresh-calls 1 0 0
refresh-check stored peer
refresh-check read-only
refresh-check peers-absent
! exists $REFRESH_ROOT/config/claude/keychain-writes.jsonl

# an_invalid_grant_after_a_peer_refresh_adopts_rather_than_asking_for_a_login
refreshfixture invalid-grant-peer
exec agentctl claude status --json --refresh --account owner@example.com
! stderr 'sk-ant|SENTINEL'
refresh-check row stdout state ok
refresh-check row stdout lock_state adopted
refresh-calls 1 1 0
refresh-check stored peer
refresh-check read-only
refresh-check peers-absent
! exists $REFRESH_ROOT/config/claude/keychain-writes.jsonl

# a_refusal_after_the_post_records_the_discarded_refresh
# a_contended_store_reports_busy_and_writes_nothing
refreshfixture migrated-contended
exec expectexit 2 agentctl claude status --json --refresh --account owner@example.com
! stderr 'sk-ant|SENTINEL'
refresh-check row stdout state busy
refresh-check row stdout lock_state busy
refresh-calls 0 1 0
refresh-check stored old
refresh-check read-only
refresh-check audit discarded
refresh-check peers-absent

# the_hold_creates_three_locks_and_a_changed_item_discards_the_refresh
refreshfixture peer-after-post
! exec agentctl claude status --refresh --account owner@example.com &changed&
refresh-action wait-pause
refresh-check peers-absent
refresh-action peer
refresh-action resume
wait changed
! stderr 'sk-ant|SENTINEL'
stdout 'refresh discarded: the item changed under us'
refresh-calls 0 1 0
refresh-check stored peer
refresh-check read-only
refresh-check audit discarded
refresh-check peers-leaked

# a_fresh_migrated_namespace_is_no_longer_terminal
refreshfixture migrated-fresh
exec agentctl claude status --json --refresh --account owner@example.com
! stderr 'sk-ant|SENTINEL'
refresh-check row stdout state ok
refresh-check row stdout source keychain
refresh-check row stdout lock_state none
stdout 'keychain service'
refresh-calls 1 0 0
refresh-check stored old
refresh-check read-only
refresh-check namespace
refresh-check peers-absent

# an_item_under_the_canonical_spelling_is_never_refreshed
refreshfixture migrated-canonical
exec agentctl claude status --json --refresh --account owner@example.com
! stderr 'sk-ant|SENTINEL'
refresh-check row stdout state migrated_to_keychain
refresh-check row stdout lock_state migrated
stdout 'item name does not match the recorded export spelling; refusing to refresh'
refresh-calls 0 0 0
refresh-check read-only
refresh-check peers-absent

# a_blob_over_the_stdin_limit_spawns_no_write
refreshfixture large-line
exec expectexit 2 agentctl claude status --json --refresh --account owner@example.com
! stderr 'sk-ant|SENTINEL'
refresh-check row stdout state error
refresh-check row stdout state_label 'blob exceeds the keychain stdin limit'
refresh-calls 0 1 0
refresh-check stored old
refresh-check read-only
refresh-check peers-absent

# the_plan_is_asked_under_the_namespace_lock_before_the_write
refreshfixture plan-locked
exec agentctl claude status --refresh --account owner@example.com &plan&
refresh-action wait-pause
refresh-calls 0 1 1
refresh-check held
refresh-action resume
wait plan
! stderr 'sk-ant|SENTINEL'
refresh-calls 1 1 1
refresh-check stored rotated
refresh-check plan pro

# a_refresh_whose_profile_answers_500_still_saves_the_rotated_credential
refreshfixture profile-failure
exec agentctl claude status --json --refresh --account owner@example.com
! stderr 'sk-ant|SENTINEL|plan|profile'
refresh-check row stdout state ok
refresh-calls 1 1 1
refresh-check stored rotated
refresh-check plan ''

# a_refused_tier_is_logged_by_its_length_and_never_stored
refreshfixture tier-refused
exec agentctl claude status --json --refresh --account owner@example.com
! stderr 'sk-ant|sentinel'
stderr 'len=65'
refresh-calls 1 1 1
refresh-check stored rotated
refresh-check plan pro

# a_pass_too_short_for_the_plan_saves_the_refresh_without_asking
refreshfixture short-budget
exec agentctl claude status --json --refresh --timeout 3s --account owner@example.com
! stderr 'sk-ant|SENTINEL'
refresh-check row stdout state ok
refresh-calls 1 1 0
refresh-check stored rotated
refresh-check plan ''

-- unchanged --
unchanged
-- untouched --
untouched
