# Process-boundary coverage from tests/e2e_refresh.rs at
# dbf6aeab84dfbe2465de496316d7bf6780940a60. Each heading names its test.
# The held-lock cases use a blocked loopback token handler instead of hold_lock;
# the holder spends one POST, and the blocked contender spends none.
# Pending writes are staged through rename_fail, except the first-write and
# removed-current vectors, whose metadata cannot be produced by a refresh.

# two_concurrent_refreshes_make_exactly_one_post
refreshfixture delayed
exec agentctl claude status --refresh --no-cache --account owner@example.com &first&
refresh-action wait-post
exec agentctl claude status --json --refresh --no-cache --account owner@example.com &second&
wait first
! stderr 'sk-ant|SENTINEL'
wait second
! stderr 'sk-ant|SENTINEL'
refresh-check row stdout state ok
refresh-check row stdout lock_state adopted
refresh-calls 2 1 0
refresh-check atomic
refresh-check stored rotated

# a_lock_held_past_the_deadline_makes_the_second_process_busy
# sigterm_during_a_held_refresh_exits_143_and_releases_the_lock
# the_lock_body_names_the_process_holding_it
refreshfixture blocked
! exec agentctl claude status --refresh --timeout 60s --account owner@example.com &holder&
refresh-action wait-post
refresh-check held
refresh-check lock-body
exec expectexit 2 agentctl claude status --json --refresh --timeout 1s --account owner@example.com
! stderr 'sk-ant|SENTINEL'
refresh-check row stdout state busy
refresh-check row stdout lock_state busy
refresh-calls 0 1 0
refresh-action terminate
wait holder
refresh-check signal-exit
refresh-check unlocked
refresh-check namespace .credentials.json
refresh-check file-unchanged
refresh-action release

# storage_mutex_status_compatibility_json_and_legacy_refresh
refreshfixture legacy
exec agentctl claude status --json --refresh --account owner@example.com
! stderr 'sk-ant|SENTINEL'
refresh-check row stdout state ok
cp stdout legacy.json
refresh-calls 1 1 0
cmp $REFRESH_NS/.storage-write unchanged
refreshfixture legacy-session
exec expectexit 2 agentctl claude status --json --refresh --account owner@example.com
! stderr 'sk-ant|SENTINEL'
refresh-check row stdout state claude_session_detected
refresh-check same-keys legacy.json stdout
refresh-calls 0 0 0
cmp $REFRESH_NS/.storage-write unchanged
refresh-check file-unchanged

# a_claude_lock_in_the_namespace_refuses_the_refresh
refreshfixture session
exec expectexit 2 agentctl claude status --refresh --account owner@example.com
! stderr 'sk-ant|SENTINEL'
stdout 'claude session detected'
refresh-calls 0 0 0
refresh-check namespace .credentials.json .oauth_refresh.lock
refresh-check file-unchanged

# a_session_appearing_after_the_post_discards_the_refresh
refreshfixture session-after-post
! exec agentctl claude status --refresh --account owner@example.com &session&
refresh-action wait-pause
refresh-calls 0 1 0
refresh-action session
refresh-action resume
wait session
! stderr 'sk-ant|SENTINEL'
stdout 'refresh discarded: namespace changed during refresh'
refresh-calls 0 1 0
refresh-check namespace .credentials.json .oauth_refresh.lock
refresh-check file-unchanged

# an_unchanged_file_replays_its_pending_without_a_post
refreshfixture owned
env AGENTCTL_FAULT=rename_fail
exec expectexit 2 agentctl claude status --refresh --account owner@example.com
! stderr 'sk-ant|SENTINEL'
stdout 'refresh saved to pending'
refresh-check namespace .credentials.json .credentials.json.pending .pending.meta
refresh-calls 1 1 0
env AGENTCTL_FAULT=
exec agentctl claude status --refresh --no-cache --account owner@example.com
! stderr 'sk-ant|SENTINEL'
stdout 'pending replayed'
refresh-calls 2 1 0
refresh-check stored rotated
refresh-check namespace .credentials.json

# a_changed_file_discards_its_pending_and_refreshes_again
refreshfixture pending-changed
env AGENTCTL_FAULT=rename_fail
exec expectexit 2 agentctl claude status --refresh --account owner@example.com
! stderr 'sk-ant|SENTINEL'
stdout 'refresh saved to pending'
refresh-calls 1 1 0
env AGENTCTL_FAULT=
refresh-action pending
exec expectexit 2 agentctl claude status --refresh --account owner@example.com
! stderr 'sk-ant|SENTINEL'
stdout 'pending discarded: file changed'
refresh-calls 2 2 0
refresh-check stored rotated
refresh-check namespace .credentials.json

# a_pending_past_its_expiry_is_replayed_and_then_refreshed
refreshfixture pending-expired
env AGENTCTL_FAULT=rename_fail
exec expectexit 2 agentctl claude status --refresh --account owner@example.com
! stderr 'sk-ant|SENTINEL'
stdout 'refresh saved to pending'
refresh-calls 1 1 0
env AGENTCTL_FAULT=
exec agentctl claude status --refresh --account owner@example.com
! stderr 'sk-ant|SENTINEL'
stdout 'pending replayed'
refresh-calls 2 2 0
refresh-check stored rotated
refresh-check namespace .credentials.json

