# Repairing an interrupted desktop switch: each cell of the state and action
# table, reached by killing a switch at one of its injected crash points.
# Every arm runs against the testing build's stand-ins; nothing here can
# reach the installed app or a real profile.
[!darwin] skip 'the desktop switch exists only on macOS'
env D=$HOME/Library/Application' 'Support/Claude
env STORE=$HOME/Library/Application' 'Support/agentctl/claude-desktop
env A=11111111-2222-3333-4444-555555555555
env B=aaaaaaaa-bbbb-cccc-dddd-eeeeeeeeeeee
env MAIN=/Applications/Claude.app/Contents/MacOS/Claude
env HELPER=/Applications/Claude.app/Contents/Frameworks/Claude' 'Helper' '(Renderer).app/Contents/MacOS/Claude' 'Helper' '(Renderer)
cp registry.json $AGENTCTL_CONFIG_DIR/config.json

# never-started, (no flag): the switch is closed as aborted, nothing moves
rm $D
rm $STORE
rm $AGCTL_FAKE_DESKTOP_LOG
exec proctable init $AGENTCTL_TEST_PROCESS_TABLE
mkdir $D
cp config-a.json $D/config.json
mkdir $STORE/profiles/$B
cp config-b.json $STORE/profiles/$B/config.json
exec proctable add $AGENTCTL_TEST_PROCESS_TABLE 500 1 $MAIN
exec proctable add $AGENTCTL_TEST_PROCESS_TABLE 501 500 $HELPER
env AGENTCTL_FAULT=desktop_abort_after_quit
exec expectexit 134 agentctl claude desktop use $B --yes
env AGENTCTL_FAULT=
exec agentctl claude desktop repair --yes
stdout '^aborted'
stdout '^state never-started'
grep '"outcome":"aborted"' $STORE/journal.jsonl
cmp $D/config.json config-a.json
cmp $STORE/profiles/$B/config.json config-b.json

# never-started, --complete: the switch is closed as aborted, nothing moves
rm $D
rm $STORE
rm $AGCTL_FAKE_DESKTOP_LOG
exec proctable init $AGENTCTL_TEST_PROCESS_TABLE
mkdir $D
cp config-a.json $D/config.json
mkdir $STORE/profiles/$B
cp config-b.json $STORE/profiles/$B/config.json
exec proctable add $AGENTCTL_TEST_PROCESS_TABLE 500 1 $MAIN
exec proctable add $AGENTCTL_TEST_PROCESS_TABLE 501 500 $HELPER
env AGENTCTL_FAULT=desktop_abort_after_quit
exec expectexit 134 agentctl claude desktop use $B --yes
env AGENTCTL_FAULT=
exec agentctl claude desktop repair --complete --yes
stdout '^aborted'
stdout '^state never-started'
grep '"outcome":"aborted"' $STORE/journal.jsonl
cmp $D/config.json config-a.json
cmp $STORE/profiles/$B/config.json config-b.json

# never-started, --revert: the switch is closed as aborted, nothing moves
rm $D
rm $STORE
rm $AGCTL_FAKE_DESKTOP_LOG
exec proctable init $AGENTCTL_TEST_PROCESS_TABLE
mkdir $D
cp config-a.json $D/config.json
mkdir $STORE/profiles/$B
cp config-b.json $STORE/profiles/$B/config.json
exec proctable add $AGENTCTL_TEST_PROCESS_TABLE 500 1 $MAIN
exec proctable add $AGENTCTL_TEST_PROCESS_TABLE 501 500 $HELPER
env AGENTCTL_FAULT=desktop_abort_after_quit
exec expectexit 134 agentctl claude desktop use $B --yes
env AGENTCTL_FAULT=
exec agentctl claude desktop repair --revert --yes
stdout '^aborted'
stdout '^state never-started'
grep '"outcome":"aborted"' $STORE/journal.jsonl
cmp $D/config.json config-a.json
cmp $STORE/profiles/$B/config.json config-b.json

# outgoing-moved, (no flag): the layout is reported and nothing moves
rm $D
rm $STORE
rm $AGCTL_FAKE_DESKTOP_LOG
exec proctable init $AGENTCTL_TEST_PROCESS_TABLE
mkdir $D
cp config-a.json $D/config.json
mkdir $STORE/profiles/$B
cp config-b.json $STORE/profiles/$B/config.json
exec proctable add $AGENTCTL_TEST_PROCESS_TABLE 500 1 $MAIN
exec proctable add $AGENTCTL_TEST_PROCESS_TABLE 501 500 $HELPER
env AGENTCTL_FAULT=desktop_abort_after_outgoing_rename
exec expectexit 134 agentctl claude desktop use $B --yes
env AGENTCTL_FAULT=
! exists $D
exec expectexit 30 agentctl claude desktop repair --yes
stdout '^state outgoing-moved'
stdout outgoing.*profiles/$A
stderr 'desktop_repair_needs_choice'
! exists $D
cmp $STORE/profiles/$A/config.json config-a.json
cmp $STORE/profiles/$B/config.json config-b.json

# outgoing-moved, --complete: the target moves in and the app starts
rm $D
rm $STORE
rm $AGCTL_FAKE_DESKTOP_LOG
exec proctable init $AGENTCTL_TEST_PROCESS_TABLE
mkdir $D
cp config-a.json $D/config.json
mkdir $STORE/profiles/$B
cp config-b.json $STORE/profiles/$B/config.json
exec proctable add $AGENTCTL_TEST_PROCESS_TABLE 500 1 $MAIN
exec proctable add $AGENTCTL_TEST_PROCESS_TABLE 501 500 $HELPER
env AGENTCTL_FAULT=desktop_abort_after_outgoing_rename
exec expectexit 134 agentctl claude desktop use $B --yes
env AGENTCTL_FAULT=
exec agentctl claude desktop repair --complete --yes
stdout '^repaired matches'
grep '"outcome":"applied","word":"repaired","verified":true' $STORE/journal.jsonl
cmp $D/config.json config-b.json
cmp $STORE/profiles/$A/config.json config-a.json
! exists $STORE/profiles/$B
exec agentctl claude desktop status --json
stdout '"open_intents": \[\]'
stdout '"running": 1'

# outgoing-moved, --revert: the outgoing profile moves back and the app starts
rm $D
rm $STORE
rm $AGCTL_FAKE_DESKTOP_LOG
exec proctable init $AGENTCTL_TEST_PROCESS_TABLE
mkdir $D
cp config-a.json $D/config.json
mkdir $STORE/profiles/$B
cp config-b.json $STORE/profiles/$B/config.json
exec proctable add $AGENTCTL_TEST_PROCESS_TABLE 500 1 $MAIN
exec proctable add $AGENTCTL_TEST_PROCESS_TABLE 501 500 $HELPER
env AGENTCTL_FAULT=desktop_abort_after_outgoing_rename
exec expectexit 134 agentctl claude desktop use $B --yes
env AGENTCTL_FAULT=
exec agentctl claude desktop repair --revert --yes
stdout '^repaired account '
grep '"outcome":"reverted","word":"repaired"' $STORE/journal.jsonl
cmp $D/config.json config-a.json
cmp $STORE/profiles/$B/config.json config-b.json
! exists $STORE/profiles/$A

# outgoing-moved, --complete, the app does not start: recorded, exit 30
rm $D
rm $STORE
rm $AGCTL_FAKE_DESKTOP_LOG
exec proctable init $AGENTCTL_TEST_PROCESS_TABLE
mkdir $D
cp config-a.json $D/config.json
mkdir $STORE/profiles/$B
cp config-b.json $STORE/profiles/$B/config.json
exec proctable add $AGENTCTL_TEST_PROCESS_TABLE 500 1 $MAIN
exec proctable add $AGENTCTL_TEST_PROCESS_TABLE 501 500 $HELPER
env AGENTCTL_FAULT=desktop_abort_after_outgoing_rename
exec expectexit 134 agentctl claude desktop use $B --yes
env AGENTCTL_FAULT=
env AGCTL_FAKE_OPEN=none
exec expectexit 30 agentctl claude desktop repair --complete --yes
stderr 'repaired_not_running'
grep '"outcome":"applied","word":"repaired_not_running","verified":false' $STORE/journal.jsonl
grep '"word":"repaired_not_running".*"app_running":false' $STORE/journal.jsonl
cmp $D/config.json config-b.json
env AGCTL_FAKE_OPEN=

# outgoing-moved, --revert, the app does not start: recorded, exit 30
rm $D
rm $STORE
rm $AGCTL_FAKE_DESKTOP_LOG
exec proctable init $AGENTCTL_TEST_PROCESS_TABLE
mkdir $D
cp config-a.json $D/config.json
mkdir $STORE/profiles/$B
cp config-b.json $STORE/profiles/$B/config.json
exec proctable add $AGENTCTL_TEST_PROCESS_TABLE 500 1 $MAIN
exec proctable add $AGENTCTL_TEST_PROCESS_TABLE 501 500 $HELPER
env AGENTCTL_FAULT=desktop_abort_after_outgoing_rename
exec expectexit 134 agentctl claude desktop use $B --yes
env AGENTCTL_FAULT=
env AGCTL_FAKE_OPEN=none
exec expectexit 30 agentctl claude desktop repair --revert --yes
stderr 'repaired_not_running'
grep '"outcome":"reverted","word":"repaired_not_running"' $STORE/journal.jsonl
cmp $D/config.json config-a.json
env AGCTL_FAKE_OPEN=

# target-installed, (no flag): the app starts on the installed target
rm $D
rm $STORE
rm $AGCTL_FAKE_DESKTOP_LOG
exec proctable init $AGENTCTL_TEST_PROCESS_TABLE
mkdir $D
cp config-a.json $D/config.json
mkdir $STORE/profiles/$B
cp config-b.json $STORE/profiles/$B/config.json
exec proctable add $AGENTCTL_TEST_PROCESS_TABLE 500 1 $MAIN
exec proctable add $AGENTCTL_TEST_PROCESS_TABLE 501 500 $HELPER
env AGENTCTL_FAULT=desktop_abort_after_target_rename
exec expectexit 134 agentctl claude desktop use $B --yes
env AGENTCTL_FAULT=
exec agentctl claude desktop repair --yes
stdout '^repaired matches'
stdout '^state target-installed'
grep '"outcome":"applied","word":"repaired"' $STORE/journal.jsonl
cmp $D/config.json config-b.json
cmp $STORE/profiles/$A/config.json config-a.json

# target-installed, --complete: the app starts on the installed target
rm $D
rm $STORE
rm $AGCTL_FAKE_DESKTOP_LOG
exec proctable init $AGENTCTL_TEST_PROCESS_TABLE
mkdir $D
cp config-a.json $D/config.json
mkdir $STORE/profiles/$B
cp config-b.json $STORE/profiles/$B/config.json
exec proctable add $AGENTCTL_TEST_PROCESS_TABLE 500 1 $MAIN
exec proctable add $AGENTCTL_TEST_PROCESS_TABLE 501 500 $HELPER
env AGENTCTL_FAULT=desktop_abort_after_target_rename
exec expectexit 134 agentctl claude desktop use $B --yes
env AGENTCTL_FAULT=
exec agentctl claude desktop repair --complete --yes
stdout '^repaired matches'
stdout '^state target-installed'
grep '"outcome":"applied","word":"repaired"' $STORE/journal.jsonl
cmp $D/config.json config-b.json
cmp $STORE/profiles/$A/config.json config-a.json

# target-installed, --revert: both profiles go back and the app starts
rm $D
rm $STORE
rm $AGCTL_FAKE_DESKTOP_LOG
exec proctable init $AGENTCTL_TEST_PROCESS_TABLE
mkdir $D
cp config-a.json $D/config.json
mkdir $STORE/profiles/$B
cp config-b.json $STORE/profiles/$B/config.json
exec proctable add $AGENTCTL_TEST_PROCESS_TABLE 500 1 $MAIN
exec proctable add $AGENTCTL_TEST_PROCESS_TABLE 501 500 $HELPER
env AGENTCTL_FAULT=desktop_abort_after_target_rename
exec expectexit 134 agentctl claude desktop use $B --yes
env AGENTCTL_FAULT=
exec agentctl claude desktop repair --revert --yes
stdout '^repaired account '
grep '"outcome":"reverted","word":"repaired"' $STORE/journal.jsonl
cmp $D/config.json config-a.json
cmp $STORE/profiles/$B/config.json config-b.json

# target-installed with the app running (the result was not recorded): --revert quits first
rm $D
rm $STORE
rm $AGCTL_FAKE_DESKTOP_LOG
exec proctable init $AGENTCTL_TEST_PROCESS_TABLE
mkdir $D
cp config-a.json $D/config.json
mkdir $STORE/profiles/$B
cp config-b.json $STORE/profiles/$B/config.json
exec proctable add $AGENTCTL_TEST_PROCESS_TABLE 500 1 $MAIN
exec proctable add $AGENTCTL_TEST_PROCESS_TABLE 501 500 $HELPER
env AGENTCTL_FAULT=desktop_result_append_fail
exec expectexit 30 agentctl claude desktop use $B --yes --json
stdout '"outcome": "journal_not_recorded"'
env AGENTCTL_FAULT=
rm $AGCTL_FAKE_DESKTOP_LOG
exec agentctl claude desktop repair --revert --yes
stdout '^state target-installed'
grep '^osascript' $AGCTL_FAKE_DESKTOP_LOG
grep '^open' $AGCTL_FAKE_DESKTOP_LOG
grep '"outcome":"reverted","word":"repaired"' $STORE/journal.jsonl
cmp $D/config.json config-a.json
cmp $STORE/profiles/$B/config.json config-b.json

# target-installed with the app running, (no flag): recorded with the main that runs
rm $D
rm $STORE
rm $AGCTL_FAKE_DESKTOP_LOG
exec proctable init $AGENTCTL_TEST_PROCESS_TABLE
mkdir $D
cp config-a.json $D/config.json
mkdir $STORE/profiles/$B
cp config-b.json $STORE/profiles/$B/config.json
exec proctable add $AGENTCTL_TEST_PROCESS_TABLE 500 1 $MAIN
exec proctable add $AGENTCTL_TEST_PROCESS_TABLE 501 500 $HELPER
env AGENTCTL_FAULT=desktop_result_append_fail
exec expectexit 30 agentctl claude desktop use $B --yes
env AGENTCTL_FAULT=
rm $AGCTL_FAKE_DESKTOP_LOG
exec agentctl claude desktop repair
stdout '^repaired matches'
! exists $AGCTL_FAKE_DESKTOP_LOG
grep '"outcome":"applied","word":"repaired","verified":true' $STORE/journal.jsonl

# unexpected-default, (no flag): a profile the app created after the crash is reported, nothing moves
rm $D
rm $STORE
rm $AGCTL_FAKE_DESKTOP_LOG
exec proctable init $AGENTCTL_TEST_PROCESS_TABLE
mkdir $D
cp config-a.json $D/config.json
mkdir $STORE/profiles/$B
cp config-b.json $STORE/profiles/$B/config.json
exec proctable add $AGENTCTL_TEST_PROCESS_TABLE 500 1 $MAIN
exec proctable add $AGENTCTL_TEST_PROCESS_TABLE 501 500 $HELPER
env AGENTCTL_FAULT=desktop_abort_after_outgoing_rename
exec expectexit 134 agentctl claude desktop use $B --yes
env AGENTCTL_FAULT=
mkdir $D
cp config-unknown.json $D/config.json
exec expectexit 30 agentctl claude desktop repair --yes
stdout '^state unexpected-default'
stderr 'desktop_repair_needs_choice'
cmp $D/config.json config-unknown.json

# unexpected-default, --complete: the stray profile is stored, the target moves in
rm $D
rm $STORE
rm $AGCTL_FAKE_DESKTOP_LOG
exec proctable init $AGENTCTL_TEST_PROCESS_TABLE
mkdir $D
cp config-a.json $D/config.json
mkdir $STORE/profiles/$B
cp config-b.json $STORE/profiles/$B/config.json
exec proctable add $AGENTCTL_TEST_PROCESS_TABLE 500 1 $MAIN
exec proctable add $AGENTCTL_TEST_PROCESS_TABLE 501 500 $HELPER
env AGENTCTL_FAULT=desktop_abort_after_outgoing_rename
exec expectexit 134 agentctl claude desktop use $B --yes
env AGENTCTL_FAULT=
mkdir $D
cp config-unknown.json $D/config.json
exec agentctl claude desktop repair --complete --yes
stdout '^repaired matches'
grep '"outcome":"applied","word":"repaired"' $STORE/journal.jsonl
cmp $D/config.json config-b.json
exec agentctl claude desktop status
stdout 'stray-[0-9a-z-]+  unknown'

# unexpected-default, --revert: the stray profile is stored, the outgoing profile moves back
rm $D
rm $STORE
rm $AGCTL_FAKE_DESKTOP_LOG
exec proctable init $AGENTCTL_TEST_PROCESS_TABLE
mkdir $D
cp config-a.json $D/config.json
mkdir $STORE/profiles/$B
cp config-b.json $STORE/profiles/$B/config.json
exec proctable add $AGENTCTL_TEST_PROCESS_TABLE 500 1 $MAIN
exec proctable add $AGENTCTL_TEST_PROCESS_TABLE 501 500 $HELPER
env AGENTCTL_FAULT=desktop_abort_after_outgoing_rename
exec expectexit 134 agentctl claude desktop use $B --yes
env AGENTCTL_FAULT=
mkdir $D
cp config-unknown.json $D/config.json
exec agentctl claude desktop repair --revert --yes
grep '"outcome":"reverted","word":"repaired"' $STORE/journal.jsonl
cmp $D/config.json config-a.json
cmp $STORE/profiles/$B/config.json config-b.json
exec agentctl claude desktop status
stdout 'stray-[0-9a-z-]+  unknown'

# a stored fresh target and a data path the app created after the crash: unexpected-default by inode
rm $D
rm $STORE
rm $AGCTL_FAKE_DESKTOP_LOG
exec proctable init $AGENTCTL_TEST_PROCESS_TABLE
mkdir $D
cp config-a.json $D/config.json
mkdir $STORE/profiles/$B
cp config-b.json $STORE/profiles/$B/config.json
exec proctable add $AGENTCTL_TEST_PROCESS_TABLE 500 1 $MAIN
exec proctable add $AGENTCTL_TEST_PROCESS_TABLE 501 500 $HELPER
rm $STORE/profiles/$B/config.json
env AGENTCTL_FAULT=desktop_abort_after_outgoing_rename
exec expectexit 134 agentctl claude desktop use $B --yes
env AGENTCTL_FAULT=
mkdir $D
exec expectexit 30 agentctl claude desktop repair --yes
stdout '^state unexpected-default'

# no-intent, (no flag): nothing to repair
rm $D
rm $STORE
rm $AGCTL_FAKE_DESKTOP_LOG
exec proctable init $AGENTCTL_TEST_PROCESS_TABLE
mkdir $D
cp config-a.json $D/config.json
mkdir $STORE/profiles/$B
cp config-b.json $STORE/profiles/$B/config.json
exec proctable add $AGENTCTL_TEST_PROCESS_TABLE 500 1 $MAIN
exec proctable add $AGENTCTL_TEST_PROCESS_TABLE 501 500 $HELPER
exec agentctl claude desktop repair --yes
stdout '^nothing_to_repair'
cmp $D/config.json config-a.json

# no-intent, --complete: nothing to repair
rm $D
rm $STORE
rm $AGCTL_FAKE_DESKTOP_LOG
exec proctable init $AGENTCTL_TEST_PROCESS_TABLE
mkdir $D
cp config-a.json $D/config.json
mkdir $STORE/profiles/$B
cp config-b.json $STORE/profiles/$B/config.json
exec proctable add $AGENTCTL_TEST_PROCESS_TABLE 500 1 $MAIN
exec proctable add $AGENTCTL_TEST_PROCESS_TABLE 501 500 $HELPER
exec agentctl claude desktop repair --complete --yes
stdout '^nothing_to_repair'
cmp $D/config.json config-a.json

# no-intent, --revert: nothing to repair
rm $D
rm $STORE
rm $AGCTL_FAKE_DESKTOP_LOG
exec proctable init $AGENTCTL_TEST_PROCESS_TABLE
mkdir $D
cp config-a.json $D/config.json
mkdir $STORE/profiles/$B
cp config-b.json $STORE/profiles/$B/config.json
exec proctable add $AGENTCTL_TEST_PROCESS_TABLE 500 1 $MAIN
exec proctable add $AGENTCTL_TEST_PROCESS_TABLE 501 500 $HELPER
exec agentctl claude desktop repair --revert --yes
stdout '^nothing_to_repair'
cmp $D/config.json config-a.json

# both flags together are a usage error
exec expectexit 2 agentctl claude desktop repair --complete --revert
stderr 'cannot be combined'

# an inconsistent layout is refused untouched and the intent stays open
rm $D
rm $STORE
rm $AGCTL_FAKE_DESKTOP_LOG
exec proctable init $AGENTCTL_TEST_PROCESS_TABLE
mkdir $D
cp config-a.json $D/config.json
mkdir $STORE/profiles/$B
cp config-b.json $STORE/profiles/$B/config.json
exec proctable add $AGENTCTL_TEST_PROCESS_TABLE 500 1 $MAIN
exec proctable add $AGENTCTL_TEST_PROCESS_TABLE 501 500 $HELPER
env AGENTCTL_FAULT=desktop_abort_after_outgoing_rename
exec expectexit 134 agentctl claude desktop use $B --yes
env AGENTCTL_FAULT=
rm $STORE/profiles/$A
exec expectexit 30 agentctl claude desktop repair --complete --yes
stdout '^state inconsistent'
stderr 'desktop_repair_inconsistent'
! exists $D
cmp $STORE/profiles/$B/config.json config-b.json
exec agentctl claude desktop status
stdout '^interrupted use'

# a fresh outgoing profile and a target without a stored profile: the launch fails, the new tree is parked
rm $D
rm $STORE
rm $AGCTL_FAKE_DESKTOP_LOG
exec proctable init $AGENTCTL_TEST_PROCESS_TABLE
mkdir $D
exec proctable add $AGENTCTL_TEST_PROCESS_TABLE 500 1 $MAIN
env AGCTL_FAKE_OPEN=nomain
exec expectexit 30 agentctl claude desktop use $B --yes --json
stdout '"outcome": "relaunch_failed"'
stdout '"park": "fresh-[0-9a-z-]+-target"'
env AGCTL_FAKE_OPEN=
exec agentctl claude desktop status
stdout 'fresh-[0-9a-z-]+-target  fresh'
stdout 'stored profiles'
exists $D

# the same, a crash before the result: target-installed by identity, --revert parks it
rm $D
rm $STORE
rm $AGCTL_FAKE_DESKTOP_LOG
exec proctable init $AGENTCTL_TEST_PROCESS_TABLE
mkdir $D
exec proctable add $AGENTCTL_TEST_PROCESS_TABLE 500 1 $MAIN
env AGENTCTL_FAULT=desktop_abort_before_result
exec expectexit 134 agentctl claude desktop use $B --yes
env AGENTCTL_FAULT=
exec agentctl claude desktop repair --revert --yes
stdout '^state target-installed'
grep '"outcome":"reverted","word":"repaired"' $STORE/journal.jsonl
exec agentctl claude desktop status
stdout 'fresh-[0-9a-z-]+-target  fresh'

# the same, a crash after the first rename: --complete leaves the data path to the app
rm $D
rm $STORE
rm $AGCTL_FAKE_DESKTOP_LOG
exec proctable init $AGENTCTL_TEST_PROCESS_TABLE
mkdir $D
exec proctable add $AGENTCTL_TEST_PROCESS_TABLE 500 1 $MAIN
env AGENTCTL_FAULT=desktop_abort_after_outgoing_rename
exec expectexit 134 agentctl claude desktop use $B --yes
env AGENTCTL_FAULT=
! exists $D
exec agentctl claude desktop repair --complete --yes
stdout '^state outgoing-moved'
grep '"outcome":"applied","word":"repaired".*"installed":\{' $STORE/journal.jsonl
exists $D

# the same, and the app never creates the data path: installed is null
rm $D
rm $STORE
rm $AGCTL_FAKE_DESKTOP_LOG
exec proctable init $AGENTCTL_TEST_PROCESS_TABLE
mkdir $D
exec proctable add $AGENTCTL_TEST_PROCESS_TABLE 500 1 $MAIN
env AGENTCTL_FAULT=desktop_abort_after_outgoing_rename
exec expectexit 134 agentctl claude desktop use $B --yes
env AGENTCTL_FAULT=
env AGCTL_FAKE_OPEN=none
exec expectexit 30 agentctl claude desktop repair --complete --yes
stderr 'repaired_not_running'
grep '"word":"repaired_not_running".*"installed":null' $STORE/journal.jsonl
! exists $D
env AGCTL_FAKE_OPEN=

# repair's own result append fails: journal_not_recorded, intent open, app running; a second repair records it
rm $D
rm $STORE
rm $AGCTL_FAKE_DESKTOP_LOG
exec proctable init $AGENTCTL_TEST_PROCESS_TABLE
mkdir $D
cp config-a.json $D/config.json
mkdir $STORE/profiles/$B
cp config-b.json $STORE/profiles/$B/config.json
exec proctable add $AGENTCTL_TEST_PROCESS_TABLE 500 1 $MAIN
exec proctable add $AGENTCTL_TEST_PROCESS_TABLE 501 500 $HELPER
env AGENTCTL_FAULT=desktop_abort_after_outgoing_rename
exec expectexit 134 agentctl claude desktop use $B --yes
env AGENTCTL_FAULT=
env AGENTCTL_FAULT=desktop_result_append_fail
exec expectexit 30 agentctl claude desktop repair --complete --yes
stderr 'journal_not_recorded'
env AGENTCTL_FAULT=
exec agentctl claude desktop status --json
stdout '"running": 1'
stdout '"op_id"'
exec agentctl claude desktop repair
stdout '^state target-installed'
stdout '^repaired matches'
grep -count=1 '"outcome":"applied"' $STORE/journal.jsonl

# repair killed between its moves and its result, --complete: the next repair finds target-installed
rm $D
rm $STORE
rm $AGCTL_FAKE_DESKTOP_LOG
exec proctable init $AGENTCTL_TEST_PROCESS_TABLE
mkdir $D
cp config-a.json $D/config.json
mkdir $STORE/profiles/$B
cp config-b.json $STORE/profiles/$B/config.json
exec proctable add $AGENTCTL_TEST_PROCESS_TABLE 500 1 $MAIN
exec proctable add $AGENTCTL_TEST_PROCESS_TABLE 501 500 $HELPER
env AGENTCTL_FAULT=desktop_abort_after_outgoing_rename
exec expectexit 134 agentctl claude desktop use $B --yes
env AGENTCTL_FAULT=
env AGENTCTL_FAULT=desktop_abort_before_result
exec expectexit 134 agentctl claude desktop repair --complete --yes
env AGENTCTL_FAULT=
exec agentctl claude desktop repair
stdout '^state target-installed'
grep -count=1 '"outcome":"applied"' $STORE/journal.jsonl
cmp $D/config.json config-b.json

# repair killed between its moves and its result, --revert: the next repair finds never-started
rm $D
rm $STORE
rm $AGCTL_FAKE_DESKTOP_LOG
exec proctable init $AGENTCTL_TEST_PROCESS_TABLE
mkdir $D
cp config-a.json $D/config.json
mkdir $STORE/profiles/$B
cp config-b.json $STORE/profiles/$B/config.json
exec proctable add $AGENTCTL_TEST_PROCESS_TABLE 500 1 $MAIN
exec proctable add $AGENTCTL_TEST_PROCESS_TABLE 501 500 $HELPER
env AGENTCTL_FAULT=desktop_abort_after_outgoing_rename
exec expectexit 134 agentctl claude desktop use $B --yes
env AGENTCTL_FAULT=
env AGENTCTL_FAULT=desktop_abort_before_result
exec expectexit 134 agentctl claude desktop repair --revert --yes
env AGENTCTL_FAULT=
exec agentctl claude desktop repair
stdout '^state never-started'
grep -count=1 '"outcome":"aborted"' $STORE/journal.jsonl
cmp $D/config.json config-a.json

# outgoing-moved, --complete, a main started again since the crash: it is quit before any move
rm $D
rm $STORE
rm $AGCTL_FAKE_DESKTOP_LOG
exec proctable init $AGENTCTL_TEST_PROCESS_TABLE
mkdir $D
cp config-a.json $D/config.json
mkdir $STORE/profiles/$B
cp config-b.json $STORE/profiles/$B/config.json
exec proctable add $AGENTCTL_TEST_PROCESS_TABLE 500 1 $MAIN
exec proctable add $AGENTCTL_TEST_PROCESS_TABLE 501 500 $HELPER
env AGENTCTL_FAULT=desktop_abort_after_outgoing_rename
exec expectexit 134 agentctl claude desktop use $B --yes
env AGENTCTL_FAULT=
exec proctable add $AGENTCTL_TEST_PROCESS_TABLE 520 1 $MAIN
exec proctable add $AGENTCTL_TEST_PROCESS_TABLE 521 520 $HELPER
rm $AGCTL_FAKE_DESKTOP_LOG
exec agentctl claude desktop repair --complete --yes
stdout '^state outgoing-moved'
stdout '^repaired matches'
grep -count=1 '^osascript -e tell application id "com.anthropic.claudefordesktop" to quit' $AGCTL_FAKE_DESKTOP_LOG
exec proctable list $AGENTCTL_TEST_PROCESS_TABLE
! stdout '^52[01] '
cmp $D/config.json config-b.json
cmp $STORE/profiles/$A/config.json config-a.json
! exists $STORE/profiles/$B

# outgoing-moved, --complete, a hosted child under the data path survived the crash: it is ended before any move
rm $D
rm $STORE
rm $AGCTL_FAKE_DESKTOP_LOG
exec proctable init $AGENTCTL_TEST_PROCESS_TABLE
mkdir $D
cp config-a.json $D/config.json
mkdir $STORE/profiles/$B
cp config-b.json $STORE/profiles/$B/config.json
exec proctable add $AGENTCTL_TEST_PROCESS_TABLE 500 1 $MAIN
exec proctable add $AGENTCTL_TEST_PROCESS_TABLE 501 500 $HELPER
env AGENTCTL_FAULT=desktop_abort_after_outgoing_rename
exec expectexit 134 agentctl claude desktop use $B --yes
env AGENTCTL_FAULT=
exec proctable add $AGENTCTL_TEST_PROCESS_TABLE 530 1 $D/claude-code/2.1.0/claude' 'code
rm $AGCTL_FAKE_DESKTOP_LOG
exec agentctl claude desktop repair --complete --yes
stdout '^state outgoing-moved'
stdout '^repaired matches'
grep -count=1 '^osascript -e tell application id "com.anthropic.claudefordesktop" to quit' $AGCTL_FAKE_DESKTOP_LOG
cmp $D/config.json config-b.json
cmp $STORE/profiles/$A/config.json config-a.json
! exists $STORE/profiles/$B

# outgoing-moved, --complete, a hosted child that outlives the quit: nothing moves, the intent stays open
rm $D
rm $STORE
rm $AGCTL_FAKE_DESKTOP_LOG
exec proctable init $AGENTCTL_TEST_PROCESS_TABLE
mkdir $D
cp config-a.json $D/config.json
mkdir $STORE/profiles/$B
cp config-b.json $STORE/profiles/$B/config.json
exec proctable add $AGENTCTL_TEST_PROCESS_TABLE 500 1 $MAIN
exec proctable add $AGENTCTL_TEST_PROCESS_TABLE 501 500 $HELPER
env AGENTCTL_FAULT=desktop_abort_after_outgoing_rename
exec expectexit 134 agentctl claude desktop use $B --yes
env AGENTCTL_FAULT=
exec proctable add $AGENTCTL_TEST_PROCESS_TABLE 530 1 $D/claude-code/2.1.0/claude' 'code
env AGCTL_FAKE_OSASCRIPT=keep-data
exec expectexit 30 agentctl claude desktop repair --complete --yes
stderr 'desktop_quit_timeout'
env AGCTL_FAKE_OSASCRIPT=
! exists $D
cmp $STORE/profiles/$A/config.json config-a.json
cmp $STORE/profiles/$B/config.json config-b.json
exec agentctl claude desktop status --json
stdout '"op_id"'

# outgoing-moved, --revert, a main started again since the crash: it is quit before any move
rm $D
rm $STORE
rm $AGCTL_FAKE_DESKTOP_LOG
exec proctable init $AGENTCTL_TEST_PROCESS_TABLE
mkdir $D
cp config-a.json $D/config.json
mkdir $STORE/profiles/$B
cp config-b.json $STORE/profiles/$B/config.json
exec proctable add $AGENTCTL_TEST_PROCESS_TABLE 500 1 $MAIN
exec proctable add $AGENTCTL_TEST_PROCESS_TABLE 501 500 $HELPER
env AGENTCTL_FAULT=desktop_abort_after_outgoing_rename
exec expectexit 134 agentctl claude desktop use $B --yes
env AGENTCTL_FAULT=
exec proctable add $AGENTCTL_TEST_PROCESS_TABLE 520 1 $MAIN
exec proctable add $AGENTCTL_TEST_PROCESS_TABLE 521 520 $HELPER
rm $AGCTL_FAKE_DESKTOP_LOG
exec agentctl claude desktop repair --revert --yes
stdout '^state outgoing-moved'
stdout '^repaired account '
grep -count=1 '^osascript -e tell application id "com.anthropic.claudefordesktop" to quit' $AGCTL_FAKE_DESKTOP_LOG
exec proctable list $AGENTCTL_TEST_PROCESS_TABLE
! stdout '^52[01] '
cmp $D/config.json config-a.json
cmp $STORE/profiles/$B/config.json config-b.json
! exists $STORE/profiles/$A

# outgoing-moved, --revert, a hosted child under the data path survived the crash: it is ended before any move
rm $D
rm $STORE
rm $AGCTL_FAKE_DESKTOP_LOG
exec proctable init $AGENTCTL_TEST_PROCESS_TABLE
mkdir $D
cp config-a.json $D/config.json
mkdir $STORE/profiles/$B
cp config-b.json $STORE/profiles/$B/config.json
exec proctable add $AGENTCTL_TEST_PROCESS_TABLE 500 1 $MAIN
exec proctable add $AGENTCTL_TEST_PROCESS_TABLE 501 500 $HELPER
env AGENTCTL_FAULT=desktop_abort_after_outgoing_rename
exec expectexit 134 agentctl claude desktop use $B --yes
env AGENTCTL_FAULT=
exec proctable add $AGENTCTL_TEST_PROCESS_TABLE 530 1 $D/claude-code/2.1.0/claude' 'code
rm $AGCTL_FAKE_DESKTOP_LOG
exec agentctl claude desktop repair --revert --yes
stdout '^state outgoing-moved'
stdout '^repaired account '
grep -count=1 '^osascript -e tell application id "com.anthropic.claudefordesktop" to quit' $AGCTL_FAKE_DESKTOP_LOG
cmp $D/config.json config-a.json
cmp $STORE/profiles/$B/config.json config-b.json
! exists $STORE/profiles/$A

# outgoing-moved, --revert, a hosted child that outlives the quit: nothing moves, the intent stays open
rm $D
rm $STORE
rm $AGCTL_FAKE_DESKTOP_LOG
exec proctable init $AGENTCTL_TEST_PROCESS_TABLE
mkdir $D
cp config-a.json $D/config.json
mkdir $STORE/profiles/$B
cp config-b.json $STORE/profiles/$B/config.json
exec proctable add $AGENTCTL_TEST_PROCESS_TABLE 500 1 $MAIN
exec proctable add $AGENTCTL_TEST_PROCESS_TABLE 501 500 $HELPER
env AGENTCTL_FAULT=desktop_abort_after_outgoing_rename
exec expectexit 134 agentctl claude desktop use $B --yes
env AGENTCTL_FAULT=
exec proctable add $AGENTCTL_TEST_PROCESS_TABLE 530 1 $D/claude-code/2.1.0/claude' 'code
env AGCTL_FAKE_OSASCRIPT=keep-data
exec expectexit 30 agentctl claude desktop repair --revert --yes
stderr 'desktop_quit_timeout'
env AGCTL_FAKE_OSASCRIPT=
! exists $D
cmp $STORE/profiles/$A/config.json config-a.json
cmp $STORE/profiles/$B/config.json config-b.json
exec agentctl claude desktop status --json
stdout '"op_id"'

# never-started with the target source replaced since the intent: inconsistent, the intent stays open
rm $D
rm $STORE
rm $AGCTL_FAKE_DESKTOP_LOG
exec proctable init $AGENTCTL_TEST_PROCESS_TABLE
mkdir $D
cp config-a.json $D/config.json
mkdir $STORE/profiles/$B
cp config-b.json $STORE/profiles/$B/config.json
exec proctable add $AGENTCTL_TEST_PROCESS_TABLE 500 1 $MAIN
exec proctable add $AGENTCTL_TEST_PROCESS_TABLE 501 500 $HELPER
env AGENTCTL_FAULT=desktop_abort_after_quit
exec expectexit 134 agentctl claude desktop use $B --yes
env AGENTCTL_FAULT=
rm $STORE/profiles/$B
mkdir $STORE/profiles/$B
cp config-b.json $STORE/profiles/$B/config.json
exec expectexit 30 agentctl claude desktop repair --yes
stdout '^state inconsistent'
stderr 'desktop_repair_inconsistent'
! grep '"type":"desktop_result"' $STORE/journal.jsonl
cmp $D/config.json config-a.json
exec agentctl claude desktop status --json
stdout '"op_id"'

# never-started with the app still running: the result records the main it saw
rm $D
rm $STORE
rm $AGCTL_FAKE_DESKTOP_LOG
exec proctable init $AGENTCTL_TEST_PROCESS_TABLE
mkdir $D
cp config-a.json $D/config.json
mkdir $STORE/profiles/$B
cp config-b.json $STORE/profiles/$B/config.json
exec proctable add $AGENTCTL_TEST_PROCESS_TABLE 500 1 $MAIN
exec proctable add $AGENTCTL_TEST_PROCESS_TABLE 501 500 $HELPER
env AGENTCTL_FAULT=desktop_abort_after_intent
exec expectexit 134 agentctl claude desktop use $B --yes
env AGENTCTL_FAULT=
exec agentctl claude desktop repair --yes
stdout '^state never-started'
stdout '^aborted .*pid 500'
grep '"word":"aborted".*"main":\{"pid":500,.*"app_running":true' $STORE/journal.jsonl
cmp $D/config.json config-a.json

# never-started when the processes cannot be observed: the result records the state as unknown
rm $D
rm $STORE
rm $AGCTL_FAKE_DESKTOP_LOG
exec proctable init $AGENTCTL_TEST_PROCESS_TABLE
mkdir $D
cp config-a.json $D/config.json
mkdir $STORE/profiles/$B
cp config-b.json $STORE/profiles/$B/config.json
exec proctable add $AGENTCTL_TEST_PROCESS_TABLE 500 1 $MAIN
exec proctable add $AGENTCTL_TEST_PROCESS_TABLE 501 500 $HELPER
env AGENTCTL_FAULT=desktop_abort_after_intent
exec expectexit 134 agentctl claude desktop use $B --yes
env AGENTCTL_FAULT=
exec proctable add $AGENTCTL_TEST_PROCESS_TABLE 540 1 $MAIN read_error=EIO
exec agentctl claude desktop repair --yes
stdout '^state never-started'
grep '"word":"aborted".*"main":null,"app_running":null' $STORE/journal.jsonl
cmp $D/config.json config-a.json

# rollback killed between its renames: the next repair finds outgoing-moved and --revert restores
rm $D
rm $STORE
rm $AGCTL_FAKE_DESKTOP_LOG
exec proctable init $AGENTCTL_TEST_PROCESS_TABLE
mkdir $D
cp config-a.json $D/config.json
mkdir $STORE/profiles/$B
cp config-b.json $STORE/profiles/$B/config.json
exec proctable add $AGENTCTL_TEST_PROCESS_TABLE 500 1 $MAIN
exec proctable add $AGENTCTL_TEST_PROCESS_TABLE 501 500 $HELPER
env AGCTL_FAKE_OPEN=fail
env AGENTCTL_FAULT=desktop_abort_mid_rollback
exec expectexit 134 agentctl claude desktop use $B --yes
env AGENTCTL_FAULT=
env AGCTL_FAKE_OPEN=
! exists $D
cmp $STORE/profiles/$B/config.json config-b.json
exec agentctl claude desktop repair --revert --yes
stdout '^state outgoing-moved'
stdout '^repaired account '
cmp $D/config.json config-a.json
cmp $STORE/profiles/$B/config.json config-b.json

# rollback killed after its renames, before the recovery launch: the next repair finds never-started
rm $D
rm $STORE
rm $AGCTL_FAKE_DESKTOP_LOG
exec proctable init $AGENTCTL_TEST_PROCESS_TABLE
mkdir $D
cp config-a.json $D/config.json
mkdir $STORE/profiles/$B
cp config-b.json $STORE/profiles/$B/config.json
exec proctable add $AGENTCTL_TEST_PROCESS_TABLE 500 1 $MAIN
exec proctable add $AGENTCTL_TEST_PROCESS_TABLE 501 500 $HELPER
env AGCTL_FAKE_OPEN=fail
env AGENTCTL_FAULT=desktop_abort_after_rollback_renames
exec expectexit 134 agentctl claude desktop use $B --yes
env AGENTCTL_FAULT=
env AGCTL_FAKE_OPEN=
exec agentctl claude desktop repair --yes
stdout '^aborted'
stdout '^state never-started'
cmp $D/config.json config-a.json
cmp $STORE/profiles/$B/config.json config-b.json

# repair killed between its moves and its launch, --complete: the next repair finds target-installed and starts the app
rm $D
rm $STORE
rm $AGCTL_FAKE_DESKTOP_LOG
exec proctable init $AGENTCTL_TEST_PROCESS_TABLE
mkdir $D
cp config-a.json $D/config.json
mkdir $STORE/profiles/$B
cp config-b.json $STORE/profiles/$B/config.json
exec proctable add $AGENTCTL_TEST_PROCESS_TABLE 500 1 $MAIN
exec proctable add $AGENTCTL_TEST_PROCESS_TABLE 501 500 $HELPER
env AGENTCTL_FAULT=desktop_abort_after_outgoing_rename
exec expectexit 134 agentctl claude desktop use $B --yes
env AGENTCTL_FAULT=desktop_abort_after_repair_renames
exec expectexit 134 agentctl claude desktop repair --complete --yes
env AGENTCTL_FAULT=
! grep '^open ' $AGCTL_FAKE_DESKTOP_LOG
exec agentctl claude desktop repair --yes
stdout '^state target-installed'
stdout '^repaired matches'
grep '^open ' $AGCTL_FAKE_DESKTOP_LOG
cmp $D/config.json config-b.json

# repair killed between its moves and its launch, --revert: the next repair finds never-started
rm $D
rm $STORE
rm $AGCTL_FAKE_DESKTOP_LOG
exec proctable init $AGENTCTL_TEST_PROCESS_TABLE
mkdir $D
cp config-a.json $D/config.json
mkdir $STORE/profiles/$B
cp config-b.json $STORE/profiles/$B/config.json
exec proctable add $AGENTCTL_TEST_PROCESS_TABLE 500 1 $MAIN
exec proctable add $AGENTCTL_TEST_PROCESS_TABLE 501 500 $HELPER
env AGENTCTL_FAULT=desktop_abort_after_outgoing_rename
exec expectexit 134 agentctl claude desktop use $B --yes
env AGENTCTL_FAULT=desktop_abort_after_repair_renames
exec expectexit 134 agentctl claude desktop repair --revert --yes
env AGENTCTL_FAULT=
exec agentctl claude desktop repair --yes
stdout '^aborted'
stdout '^state never-started'
cmp $D/config.json config-a.json
cmp $STORE/profiles/$B/config.json config-b.json

