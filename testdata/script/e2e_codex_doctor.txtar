# Provenance: tests/e2e_codex_doctor.rs; headings retain exact reference test names.

# the_report_names_every_item_and_validates_against_the_schema
codex-doctor-fixture all
exec agentctl codex doctor
cp stdout doctor-table.txt
cp stderr doctor-table-stderr.txt
! stderr 'agctl-test-codex-(at|rt|ak|jwt|email)-|eyJ|[Bb]earer '
exec agentctl codex doctor --json
cp stdout doctor-report.json
cp stderr doctor-json-stderr.txt
! stderr 'agctl-test-codex-(at|rt|ak|jwt|email)-|eyJ|[Bb]earer '
codex-doctor-check

# a_credential_that_is_read_is_reported_by_its_shape_only
codex-doctor-fixture shape
