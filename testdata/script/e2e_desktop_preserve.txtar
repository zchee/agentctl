# Nothing inside a profile is ever created, removed, rewritten or replaced
# by status, use, repair or a refusal: each profile's signature (relative
# path, type, size, modification time and inode of every entry) is the same
# before and after, wherever the profile was moved to. forget removes the
# one profile it names and leaves every other signature unchanged. Every arm
# runs against the testing build's stand-ins.
[!darwin] skip 'the desktop switch exists only on macOS'
env D=$HOME/Library/Application' 'Support/Claude
env STORE=$HOME/Library/Application' 'Support/agentctl/claude-desktop
env A=11111111-2222-3333-4444-555555555555
env B=aaaaaaaa-bbbb-cccc-dddd-eeeeeeeeeeee
env C=cccccccc-1111-2222-3333-444444444444
env MAIN=/Applications/Claude.app/Contents/MacOS/Claude
cp registry.json $AGENTCTL_CONFIG_DIR/config.json
mkdir $D/claude-code-sessions/s1 $D/Local' 'Storage
cp config-a.json $D/config.json
cp config-a.json $D/claude-code-sessions/s1/state.json
cp config-a.json $D/Local' 'Storage/leveldb.log
mkdir $STORE/profiles/$B/claude-code-sessions/s2
cp config-b.json $STORE/profiles/$B/config.json
cp config-b.json $STORE/profiles/$B/claude-code-sessions/s2/state.json
mkdir $STORE/profiles/$C
cp config-c.json $STORE/profiles/$C/config.json
exec proctable add $AGENTCTL_TEST_PROCESS_TABLE 500 1 $MAIN
exec treesig $D
cp stdout a.sig
exec treesig $STORE/profiles/$B
cp stdout b.sig
exec treesig $STORE/profiles/$C
cp stdout c.sig

# status reads and never changes anything
exec agentctl claude desktop status --json
stdout '"word": "foreign"'
exec treesig $D
cmp stdout a.sig
exec treesig $STORE/profiles/$B
cmp stdout b.sig
exec treesig $STORE/profiles/$C
cmp stdout c.sig

# every refusal before the quit leaves every profile as it was
cp fake-stat.sh $AGENTCTL_DESKTOP_TEST_ROOT/usr/bin/stat
chmod 0755 $AGENTCTL_DESKTOP_TEST_ROOT/usr/bin/stat
exec expectexit 30 agentctl claude desktop use $B --yes
stderr 'desktop_cross_device'
rm $AGENTCTL_DESKTOP_TEST_ROOT/usr/bin/stat
exec proctable add $AGENTCTL_TEST_PROCESS_TABLE 600 1 /Users/me/Applications/Claude.app/Contents/MacOS/Claude
exec expectexit 30 agentctl claude desktop use $B --yes
stderr 'desktop_other_copy_running'
exec proctable rm $AGENTCTL_TEST_PROCESS_TABLE 600
env AGENTCTL_FAULT=desktop_intent_append_fail
exec expectexit 30 agentctl claude desktop use $B --yes
stderr 'desktop_journal_failed'
env AGENTCTL_FAULT=
exec expectexit 2 agentctl claude desktop use $C --yes
stderr 'no account matches'
env AGCTL_FAKE_OSASCRIPT=refuse
exec expectexit 30 agentctl claude desktop use $B --yes
stderr 'desktop_quit_refused'
env AGCTL_FAKE_OSASCRIPT=keep
exec expectexit 30 agentctl claude desktop use $B --yes
stderr 'desktop_quit_timeout'
env AGCTL_FAKE_OSASCRIPT=
exec treesig $D
cmp stdout a.sig
exec treesig $STORE/profiles/$B
cmp stdout b.sig
exec treesig $STORE/profiles/$C
cmp stdout c.sig

# a stored profile that names another account, then one that cannot be
# read, stands in for B: both are refused and nothing changes, neither in
# them nor in the profiles around them
mv $STORE/profiles/$B $WORK/b.aside
mkdir $STORE/profiles/$B
cp config-a.json $STORE/profiles/$B/config.json
exec treesig $STORE/profiles/$B
cp stdout m.sig
exec expectexit 30 agentctl claude desktop use $B --yes
stderr 'desktop_profile_mismatch'
exec treesig $STORE/profiles/$B
cmp stdout m.sig
rm $STORE/profiles/$B
mkdir $STORE/profiles/$B
cp config-broken.json $STORE/profiles/$B/config.json
exec treesig $STORE/profiles/$B
cp stdout u.sig
exec expectexit 30 agentctl claude desktop use $B --yes
stderr 'desktop_profile_unreadable'
exec treesig $STORE/profiles/$B
cmp stdout u.sig
rm $STORE/profiles/$B
mv $WORK/b.aside $STORE/profiles/$B
exec treesig $D
cmp stdout a.sig
exec treesig $STORE/profiles/$B
cmp stdout b.sig
exec treesig $STORE/profiles/$C
cmp stdout c.sig

# the outgoing profile's stored name already taken: refused, the profile
# holding that name is untouched too
mkdir $STORE/profiles/$A
cp config-a.json $STORE/profiles/$A/config.json
exec treesig $STORE/profiles/$A
cp stdout x.sig
exec expectexit 30 agentctl claude desktop use $B --yes
stderr 'desktop_destination_exists'
exec treesig $STORE/profiles/$A
cmp stdout x.sig
rm $STORE/profiles/$A
exec treesig $D
cmp stdout a.sig
exec treesig $STORE/profiles/$B
cmp stdout b.sig
exec treesig $STORE/profiles/$C
cmp stdout c.sig

# the desktop lock held by another operation
! exec flockhold $STORE/lock 10m $WORK/lock-held &holder&
exec waitfor $WORK/lock-held
exec expectexit 30 agentctl claude desktop use $B --yes
stderr 'desktop_lock_busy'
kill holder
wait holder
exec treesig $D
cmp stdout a.sig
exec treesig $STORE/profiles/$B
cmp stdout b.sig
exec treesig $STORE/profiles/$C
cmp stdout c.sig

# no main executable, then a bundle path that is a link
mv $AGENTCTL_DESKTOP_TEST_ROOT/Applications/Claude.app/Contents/MacOS/Claude $WORK/claude.saved
exec expectexit 30 agentctl claude desktop use $B --yes
stderr 'desktop_app_not_found'
mv $WORK/claude.saved $AGENTCTL_DESKTOP_TEST_ROOT/Applications/Claude.app/Contents/MacOS/Claude
mv $AGENTCTL_DESKTOP_TEST_ROOT/Applications/Claude.app $WORK/real.app
symlink $AGENTCTL_DESKTOP_TEST_ROOT/Applications/Claude.app -> $WORK/real.app
exec expectexit 30 agentctl claude desktop use $B --yes
stderr 'desktop_bundle_mismatch'
rm $AGENTCTL_DESKTOP_TEST_ROOT/Applications/Claude.app
mv $WORK/real.app $AGENTCTL_DESKTOP_TEST_ROOT/Applications/Claude.app
exec treesig $D
cmp stdout a.sig
exec treesig $STORE/profiles/$B
cmp stdout b.sig
exec treesig $STORE/profiles/$C
cmp stdout c.sig

# an interrupted operation left open refuses the next switch; repair then
# closes it as never started, moving nothing
env AGENTCTL_FAULT=desktop_abort_after_intent
exec expectexit 134 agentctl claude desktop use $B --yes
env AGENTCTL_FAULT=
exec expectexit 30 agentctl claude desktop use $B --yes
stderr 'desktop_intent_open'
exec treesig $D
cmp stdout a.sig
exec treesig $STORE/profiles/$B
cmp stdout b.sig
exec treesig $STORE/profiles/$C
cmp stdout c.sig
exec agentctl claude desktop repair --yes
stdout '^aborted'
exec treesig $D
cmp stdout a.sig
exec treesig $STORE/profiles/$B
cmp stdout b.sig
exec treesig $STORE/profiles/$C
cmp stdout c.sig

# a launch that fails twice is rolled back with every entry intact
env AGCTL_FAKE_OPEN=fail
exec expectexit 30 agentctl claude desktop use $B --yes
stderr 'relaunch_failed'
env AGCTL_FAKE_OPEN=
exec treesig $D
cmp stdout a.sig
exec treesig $STORE/profiles/$B
cmp stdout b.sig
exec treesig $STORE/profiles/$C
cmp stdout c.sig

# a switch moves the two profiles and changes nothing inside them
exec agentctl claude desktop use $B --yes
stdout '^selected matches'
exec treesig $STORE/profiles/$A
cmp stdout a.sig
exec treesig $D
cmp stdout b.sig
exec treesig $STORE/profiles/$C
cmp stdout c.sig

# and the switch back
exec agentctl claude desktop use $A --yes
exec treesig $D
cmp stdout a.sig
exec treesig $STORE/profiles/$B
cmp stdout b.sig
exec treesig $STORE/profiles/$C
cmp stdout c.sig

# repair after a crash between the renames: --revert and --complete
env AGENTCTL_FAULT=desktop_abort_after_outgoing_rename
exec expectexit 134 agentctl claude desktop use $B --yes
env AGENTCTL_FAULT=
exec expectexit 30 agentctl claude desktop repair --yes
exec agentctl claude desktop repair --revert --yes
exec treesig $D
cmp stdout a.sig
exec treesig $STORE/profiles/$B
cmp stdout b.sig
exec treesig $STORE/profiles/$C
cmp stdout c.sig
env AGENTCTL_FAULT=desktop_abort_after_outgoing_rename
exec expectexit 134 agentctl claude desktop use $B --yes
env AGENTCTL_FAULT=
exec agentctl claude desktop repair --complete --yes
exec treesig $STORE/profiles/$A
cmp stdout a.sig
exec treesig $D
cmp stdout b.sig
exec treesig $STORE/profiles/$C
cmp stdout c.sig

# forget removes the named profile and nothing else
exec proctable init $AGENTCTL_TEST_PROCESS_TABLE
exec agentctl claude desktop forget $C --yes
! exists $STORE/profiles/$C
exec treesig $STORE/profiles/$A
cmp stdout a.sig
exec treesig $D
cmp stdout b.sig

# a switch whose result cannot be recorded: both profiles moved intact, the
# intent stays open, and repair records what it finds without moving them
env AGENTCTL_FAULT=desktop_result_append_fail
exec expectexit 30 agentctl claude desktop use $A --yes
stderr 'journal_not_recorded'
env AGENTCTL_FAULT=
exec treesig $D
cmp stdout a.sig
exec treesig $STORE/profiles/$B
cmp stdout b.sig
exec agentctl claude desktop repair --yes
exec treesig $D
cmp stdout a.sig
exec treesig $STORE/profiles/$B
cmp stdout b.sig

# status with a partial error changes nothing: the journal unreadable,
# then the profiles directory replaced by a regular file
mv $STORE/journal.jsonl $WORK/journal.aside
mkdir $STORE/journal.jsonl
exec expectexit 30 agentctl claude desktop status --json
stdout '"step": "journal"'
exec treesig $D
cmp stdout a.sig
exec treesig $STORE/profiles/$B
cmp stdout b.sig
rm $STORE/journal.jsonl
mv $WORK/journal.aside $STORE/journal.jsonl
mv $STORE/profiles $WORK/profiles.aside
cp config-b.json $STORE/profiles
exec expectexit 30 agentctl claude desktop status --json
stdout '"step": "profiles"'
exec treesig $D
cmp stdout a.sig
exec treesig $WORK/profiles.aside/$B
cmp stdout b.sig
rm $STORE/profiles
mv $WORK/profiles.aside $STORE/profiles
exec treesig $STORE/profiles/$B
cmp stdout b.sig

# the processes cannot be listed: use and forget refuse and nothing changes
exec proctable add $AGENTCTL_TEST_PROCESS_TABLE 920 1 $MAIN read_error=EIO
exec expectexit 30 agentctl claude desktop use $B --yes
stderr 'desktop_observe_failed'
exec expectexit 30 agentctl claude desktop forget $B --yes
stderr 'desktop_observe_failed'
exec proctable rm $AGENTCTL_TEST_PROCESS_TABLE 920
exec treesig $D
cmp stdout a.sig
exec treesig $STORE/profiles/$B
cmp stdout b.sig

# repair refuses without a choice and when its quit times out: the two
# profiles keep their signatures where the crash left them, and the chosen
# repair then restores them intact
env AGENTCTL_FAULT=desktop_abort_after_outgoing_rename
exec expectexit 134 agentctl claude desktop use $B --yes
env AGENTCTL_FAULT=
! exists $D
exec expectexit 30 agentctl claude desktop repair --yes
stderr 'desktop_repair_needs_choice'
exec treesig $STORE/profiles/$A
cmp stdout a.sig
exec treesig $STORE/profiles/$B
cmp stdout b.sig
exec proctable add $AGENTCTL_TEST_PROCESS_TABLE 930 1 $MAIN
env AGCTL_FAKE_OSASCRIPT=keep
exec expectexit 30 agentctl claude desktop repair --revert --yes
stderr 'desktop_quit_timeout'
env AGCTL_FAKE_OSASCRIPT=
! exists $D
exec treesig $STORE/profiles/$A
cmp stdout a.sig
exec treesig $STORE/profiles/$B
cmp stdout b.sig
exec proctable rm $AGENTCTL_TEST_PROCESS_TABLE 930
exec agentctl claude desktop repair --revert --yes
stdout '^repaired '
exec treesig $D
cmp stdout a.sig
exec treesig $STORE/profiles/$B
cmp stdout b.sig

# repair refuses a layout it cannot reconcile: the stored target replaced
# since the intent keeps its own signature, and so do the original and the
# profile at the data path
env AGENTCTL_FAULT=desktop_abort_after_quit
exec expectexit 134 agentctl claude desktop use $B --yes
env AGENTCTL_FAULT=
mv $STORE/profiles/$B $WORK/b.aside
mkdir $STORE/profiles/$B
cp config-b.json $STORE/profiles/$B/config.json
exec treesig $STORE/profiles/$B
cp stdout r.sig
exec expectexit 30 agentctl claude desktop repair --yes
stderr 'desktop_repair_inconsistent'
exec treesig $STORE/profiles/$B
cmp stdout r.sig
exec treesig $WORK/b.aside
cmp stdout b.sig
exec treesig $D
cmp stdout a.sig
rm $STORE/profiles/$B
mv $WORK/b.aside $STORE/profiles/$B
exec agentctl claude desktop repair --yes
stdout '^aborted'
exec treesig $D
cmp stdout a.sig
exec treesig $STORE/profiles/$B
cmp stdout b.sig

# forget's refusals delete nothing: the app running, the profile in place
# (a stored copy of it), the lock held and an open intent; the profile named
# keeps its signature each time, and so does every other one
exec agentctl claude desktop use $B --yes
stdout '^selected matches'
exec expectexit 30 agentctl claude desktop forget $A --yes
stderr 'desktop_app_running'
exec treesig $STORE/profiles/$A
cmp stdout a.sig
exec treesig $D
cmp stdout b.sig
exec proctable init $AGENTCTL_TEST_PROCESS_TABLE
mkdir $STORE/profiles/$B
cp config-b.json $STORE/profiles/$B/config.json
exec treesig $STORE/profiles/$B
cp stdout s.sig
exec expectexit 30 agentctl claude desktop forget $B --yes
stderr 'desktop_profile_in_place'
exec treesig $STORE/profiles/$B
cmp stdout s.sig
exec treesig $D
cmp stdout b.sig
exec treesig $STORE/profiles/$A
cmp stdout a.sig
rm $STORE/profiles/$B
! exec flockhold $STORE/lock 10m $WORK/forget-lock-held &forgetholder&
exec waitfor $WORK/forget-lock-held
exec expectexit 30 agentctl claude desktop forget $A --yes
stderr 'desktop_lock_busy'
kill forgetholder
wait forgetholder
exec treesig $STORE/profiles/$A
cmp stdout a.sig
exec treesig $D
cmp stdout b.sig
env AGENTCTL_FAULT=desktop_abort_after_intent
exec expectexit 134 agentctl claude desktop use $A --yes
env AGENTCTL_FAULT=
exec expectexit 30 agentctl claude desktop forget $A --yes
stderr 'desktop_intent_open'
exec treesig $STORE/profiles/$A
cmp stdout a.sig
exec treesig $D
cmp stdout b.sig
exec agentctl claude desktop repair --yes
stdout '^aborted'
exec treesig $STORE/profiles/$A
cmp stdout a.sig
exec treesig $D
cmp stdout b.sig

# The same holds for the desktop switch that follows a live swap, on every
# path of --desktop: forward, undo, the undo refused, a refusal before the
# quit, a switch rolled back, and a swap that never applied.
swapfixture live preserve-desktop
undo-setup
env D=$HOME/Library/Application' 'Support/Claude
env STORE=$HOME/Library/Application' 'Support/agentctl/claude-desktop
env O=11111111-2222-3333-4444-555555555555
env I=44444444-4444-4444-8444-444444444444
env T=55555555-5555-4555-8555-555555555555
exec proctable init $AGENTCTL_TEST_PROCESS_TABLE
mkdir $D/claude-code-sessions/s1 $D/Local' 'Storage
cp config-o.json $D/config.json
cp config-o.json $D/claude-code-sessions/s1/state.json
cp config-o.json $D/Local' 'Storage/leveldb.log
mkdir $STORE/profiles/$I/claude-code-sessions/s2
cp config-i.json $STORE/profiles/$I/config.json
cp config-i.json $STORE/profiles/$I/claude-code-sessions/s2/state.json
mkdir $STORE/profiles/$T
cp config-t.json $STORE/profiles/$T/config.json
exec proctable add $AGENTCTL_TEST_PROCESS_TABLE 500 1 $MAIN
exec treesig $D
cp stdout o.sig
exec treesig $STORE/profiles/$I
cp stdout i.sig
exec treesig $STORE/profiles/$T
cp stdout t.sig

# a swap that never applied: the switch does not run
exec expectexit 20 agentctl claude use $I --live --json --desktop
stdout '"detail": "the swap did not apply, so the desktop app was left alone"'
exec treesig $D
cmp stdout o.sig
exec treesig $STORE/profiles/$I
cmp stdout i.sig
exec treesig $STORE/profiles/$T
cmp stdout t.sig

# a refusal before the quit: an open intent
mkdir $STORE
cp open-intent.jsonl $STORE/journal.jsonl
exec agentctl claude use $I --live --yes --json --desktop
stdout '^    "outcome": "desktop_intent_open",$'
exec treesig $D
cmp stdout o.sig
exec treesig $STORE/profiles/$I
cmp stdout i.sig
exec treesig $STORE/profiles/$T
cmp stdout t.sig
rm $STORE/journal.jsonl
exec agentctl claude use --undo --yes --json
stdout '^  "outcome": "applied",$'

# a switch whose target does not start is rolled back intact
env AGCTL_FAKE_OPEN=fail-once
exec agentctl claude use $I --live --yes --json --desktop
stdout '^    "outcome": "reverted_relaunched",$'
rm $AGENTCTL_TEST_PROCESS_TABLE.open-failed
env AGCTL_FAKE_OPEN=
exec treesig $D
cmp stdout o.sig
exec treesig $STORE/profiles/$I
cmp stdout i.sig
exec treesig $STORE/profiles/$T
cmp stdout t.sig
exec agentctl claude use --undo --yes --json
stdout '^  "outcome": "applied",$'

# forward: the two profiles change places and nothing inside them changes
exec agentctl claude use $I --live --yes --json --desktop
stdout '^    "outcome": "selected",$'
stdout '^    "identity": "matches",$'
exec treesig $STORE/profiles/$O
cmp stdout o.sig
exec treesig $D
cmp stdout i.sig
exec treesig $STORE/profiles/$T
cmp stdout t.sig

# undo: they change places back, intact
exec agentctl claude use --undo --yes --json --desktop
stdout '^    "outcome": "selected",$'
exec treesig $D
cmp stdout o.sig
exec treesig $STORE/profiles/$I
cmp stdout i.sig
exec treesig $STORE/profiles/$T
cmp stdout t.sig

# the undo refused: a third account signed in on the profile the forward
# switch installed; nothing anywhere changes
exec agentctl claude use $I --live --yes --json --desktop
stdout '^    "outcome": "selected",$'
cp config-t.json $D/config.json
exec treesig $D
cp stdout d-third.sig
exec agentctl claude use --undo --yes --json --desktop
stdout '^    "outcome": "desktop_profile_mismatch",$'
exec treesig $D
cmp stdout d-third.sig
exec treesig $STORE/profiles/$O
cmp stdout o.sig
exec treesig $STORE/profiles/$T
cmp stdout t.sig

-- registry.json --
{
  "version": 1,
  "accounts": [{
    "account_uuid": "11111111-2222-3333-4444-555555555555",
    "organization_uuid": "66666666-7777-8888-9999-000000000000",
    "email": "a@example.com",
    "org_name": "Acme",
    "label": "a",
    "kind": {"kind": "owned", "export_spelling": "", "export_sha8": ""},
    "forgotten": false,
    "created_at": "2026-09-08T00:00:00Z"
  }, {
    "account_uuid": "aaaaaaaa-bbbb-cccc-dddd-eeeeeeeeeeee",
    "organization_uuid": "66666666-7777-8888-9999-000000000000",
    "email": "b@example.com",
    "org_name": "Acme",
    "label": "b",
    "kind": {"kind": "owned", "export_spelling": "", "export_sha8": ""},
    "forgotten": false,
    "created_at": "2026-09-08T00:00:00Z"
  }]
}
-- config-a.json --
{"lastKnownAccountUuid":"11111111-2222-3333-4444-555555555555","darkMode":"system"}
-- config-b.json --
{"lastKnownAccountUuid":"aaaaaaaa-bbbb-cccc-dddd-eeeeeeeeeeee"}
-- config-broken.json --
{"lastKnownAccountUuid":
-- config-c.json --
{"lastKnownAccountUuid":"cccccccc-1111-2222-3333-444444444444"}
-- fake-stat.sh --
#!/bin/sh
case "$3" in
*/claude-desktop/profiles) echo 2 ;;
*) echo 1 ;;
esac
-- config-o.json --
{"lastKnownAccountUuid":"11111111-2222-3333-4444-555555555555","darkMode":"system"}
-- config-i.json --
{"lastKnownAccountUuid":"44444444-4444-4444-8444-444444444444","darkMode":"system"}
-- config-t.json --
{"lastKnownAccountUuid":"55555555-5555-4555-8555-555555555555","darkMode":"system"}
-- open-intent.jsonl --
{"type":"desktop_intent","op_id":"0123456789abcdef","time":"2026-10-13T00:00:00Z","command":"use","requested_account":"55555555-5555-4555-8555-555555555555","outgoing":null,"target":{"name":"55555555-5555-4555-8555-555555555555","identity":{"state":"none"},"source":"/nonexistent","target_existed":false,"park":"fresh-0123456789abcdef-target"}}
